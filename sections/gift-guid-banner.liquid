{%- style -%}
.holiday-gift-section{
  position:relative;
  max-width:100%;
  margin:0 auto;
  background:#ffffff;
  border:1px solid #e0e0e0;
  height:1050px;
  overflow:hidden;
}

/* --- HEADER BAR --- */
.header-content-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:15px 40px;
  background:#ffffff;
  border-bottom:1px solid #f0f0f0;
}

.brand-title{
  font-size:20px;
  font-weight:bold;
  text-transform:uppercase;
  color:#000;
}

.header-tagline{
  font-size:16px;
  color:#000;
}

/* --- FRAMES: full-width auto --- */
.header-area,
.content-area{
  height:265px;
  position:relative;
  overflow:hidden;
}
.header-frame-img{
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:100%;
  object-fit:cover;
}
.content-frame-img{
  position:absolute;
  top:0;
  right:0;
  width:calc(40% - 30px);   /* 40 % of area, minus left text-card offset */
  height:100%;
  object-fit:cover;
}
/* --- TEXT BOX --- */
.text-content-box{
  position:absolute;
  top:50%;
  left:30px;
  transform:translateY(-50%);
  width:60%;
  max-width:600px;
  background:rgba(255,255,255,.98);
  padding:40px;
  box-shadow:0 4px 12px rgba(0,0,0,.12);
}
.main-heading{
  font-size:48px;
  font-weight:bold;
  line-height:1.1;
  margin:0 0 15px;
}
.description-text{
  font-size:18px;
  margin:0 0 20px;
  color:#333;
}

/* --- BUTTONS: left→right reveal --- */
.gift-choose-btn,
.shop-now-btn{
  padding:12px 24px;
  font-weight:bold;
  text-decoration:none;
  display:inline-block;
  cursor:pointer;
  border:none;
  background-size:200% 100%;
  transition:background-position .4s ease, color .4s ease;
}
/* CHOOSE GIFT  yellow→black */
.gift-choose-btn{
  color:#000;
  background-image:linear-gradient(to right, #000 0%, #000 50%, #ffff00 50%, #ffff00 100%);
  background-position:100% 0;
}
.gift-choose-btn:hover{
  background-position:0 0;
  color:#ffff00;
}
.sustainable-line{
  font-size:14px;
  color:#666;
  margin-top:12px;
}
/* SHOP NOW  black→yellow */
.shop-now-btn{
  color:#fff;
  background-image:linear-gradient(to right, #ffff00 0%, #ffff00 50%, #000 50%, #000 100%);
  background-position:100% 0;
}
.shop-now-btn:hover{
  background-position:0 0;
  color:#000;
}

/* --- RESPONSIVE --- */
@media(max-width:768px){
  .holiday-gift-section{height:auto;}
  .header-content-row{
    flex-direction:column;
    gap:15px;
    text-align:center;
    padding:20px;
  }
  .text-content-box{
    position:static;
    width:100%;
    max-width:none;
    margin:0;
    padding:20px;
    transform:none;
  }
  .header-frame-img,
  .content-frame-img{
    width:100%;
    opacity:.3;
  }
  .main-heading{font-size:32px;}
  .description-text{font-size:16px;}
}
{%- endstyle -%}

<!-- ---------------- MARK-UP ---------------- -->
<div class="holiday-gift-section">
  <!-- Header bar -->
  <div class="header-content-row">
    <div class="brand-title">{{ section.settings.brand_name | default: 'TISSO VISON' }}</div>
    <div class="header-tagline">{{ section.settings.header_tagline | default: 'Find the ideal gift for your loved ones.' }}</div>
    {% if section.settings.choose_gift_url != blank %}
      <a href="{{ section.settings.choose_gift_url }}" class="gift-choose-btn">{{ section.settings.choose_gift_text | default: 'CHOOSE GIFT →' }}</a>
    {% else %}
      <button class="gift-choose-btn">{{ section.settings.choose_gift_text | default: 'CHOOSE GIFT →' }}</button>
    {% endif %}
  </div>

  <!-- Top frame image -->
  <div class="header-area">
    {% if section.settings.header_frame != blank %}
      <img src="{{ section.settings.header_frame | image_url: width: 1440, height: 195 }}" alt="" class="header-frame-img" loading="lazy">
    {% endif %}
  </div>

  <!-- Bottom frame image + text -->
  <div class="content-area">
    {% if section.settings.side_frame != blank %}
      <img src="{{ section.settings.side_frame | image_url: width: 936, height: 195 }}" alt="" class="content-frame-img" loading="lazy">
    {% endif %}

    <div class="text-content-box">
      <h1 class="main-heading">{{ section.settings.main_title | default: 'The Gift Guide' }}</h1>
      <p class="description-text">{{ section.settings.description | default: 'Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.' }}</p>

      {% if section.settings.shop_now_url != blank %}
        <a href="{{ section.settings.shop_now_url }}" class="shop-now-btn">{{ section.settings.shop_now_text | default: 'SHOP NOW →' }}</a>
      {% else %}
        <button class="shop-now-btn">{{ section.settings.shop_now_text | default: 'SHOP NOW →' }}</button>
      {% endif %}
      {% if section.settings.sustainable_text != blank %}
  <p class="sustainable-line">{{ section.settings.sustainable_text }}</p>
{% endif %}
    </div>
  </div>
</div>

