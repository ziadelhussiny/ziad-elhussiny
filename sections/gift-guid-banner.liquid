{%- style -%}
.gift-guide-banner {
  background-color: #ffffff;
  position: relative;
  height: 390px;
  max-width: 1440px;
  margin: 0 auto;
  overflow: hidden;
}

.top-section {
  height: 195px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40px;
  background: transparent;
}

.top-frame {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  z-index: 1;
  display: block;
}

.top-content {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.brand-name {
  font-size: 20px;
  font-weight: bold;
  text-transform: uppercase;
  color: #000;
}

.tagline {
  font-size: 16px;
  color: #000;
}

.choose-button {
  background-color: #ffff00;
  color: #000000;
  padding: 10px 20px;
  border: none;
  cursor: pointer;
  font-weight: bold;
  text-decoration: none;
  display: inline-block;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.choose-button:hover {
  background-color: #000000;
  color: #ffff00;
}

.bottom-section {
  height: 195px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  background: transparent;
}

.bottom-frame {
  position: absolute;
  top: 0;
  right: 0;
  width: 60%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  z-index: 1;
  display: block;
}

.main-content {
  position: relative;
  z-index: 2;
  padding: 40px;
  width: 50%;
  background-color: rgba(255, 255, 255, 0.95);
  margin: 20px 0 20px 20px;
  backdrop-filter: blur(2px);
}

.title {
  font-size: 48px;
  font-weight: bold;
  line-height: 1.1;
  margin: 0 0 15px 0;
  color: #000;
}

.subtitle {
  font-size: 18px;
  margin: 0 0 20px 0;
  color: #000;
  line-height: 1.4;
}

.shop-button {
  background-color: #000000;
  color: #ffffff;
  padding: 12px 24px;
  border: none;
  cursor: pointer;
  font-weight: bold;
  text-decoration: none;
  display: inline-block;
  transition: all 0.3s ease;
}

.shop-button:hover {
  background-color: #333333;
  transform: translateY(-1px);
}

.additional-content {
  margin-top: 15px;
}

.additional-image {
  max-width: 100%;
  height: auto;
}

/* Responsive Design */
@media (max-width: 768px) {
  .gift-guide-banner {
    height: auto;
  }
  
  .top-section,
  .bottom-section {
    height: auto;
    min-height: 150px;
    padding: 20px;
  }
  
  .top-content {
    flex-direction: column;
    gap: 15px;
    text-align: center;
  }
  
  .main-content {
    width: 100%;
    margin: 0;
    padding: 20px;
  }
  
  .title {
    font-size: 32px;
  }
  
  .subtitle {
    font-size: 16px;
  }
  
  .bottom-frame {
    width: 100%;
    opacity: 0.3;
  }
}
{%- endstyle -%}

<div class="gift-guide-banner">
  <!-- Top Section with Header Frame -->
  <div class="top-section">
    {% if section.settings.top_frame_image != blank %}
      <img src="{{ section.settings.top_frame_image | image_url: width: 1440, height: 195 }}" 
           alt="Top Frame with Items" 
           loading="lazy" 
           width="1440" 
           height="195" 
           class="top-frame">
    {% else %}
      <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(45deg, #f0f0f0 25%, transparent 25%), linear-gradient(-45deg, #f0f0f0 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #f0f0f0 75%), linear-gradient(-45deg, transparent 75%, #f0f0f0 75%); background-size: 20px 20px; background-position: 0 0, 0 10px, 10px -10px, -10px 0px; z-index: 1;"></div>
    {% endif %}
    
    <div class="top-content">
      <div class="brand-name">{{ section.settings.brand_text }}</div>
      <div class="tagline">{{ section.settings.tagline_text }}</div>
      {% if section.settings.choose_button_link != blank %}
        <a href="{{ section.settings.choose_button_link }}" class="choose-button">
          {{ section.settings.choose_button_text }}
        </a>
      {% else %}
        <button class="choose-button">{{ section.settings.choose_button_text }}</button>
      {% endif %}
    </div>
  </div>

  <!-- Bottom Section with Side Frame -->
  <div class="bottom-section">
    {% if section.settings.bottom_frame_image != blank %}
      <img src="{{ section.settings.bottom_frame_image | image_url: width: 864, height: 195 }}" 
           alt="Bottom Frame with Items" 
           loading="lazy" 
           width="864" 
           height="195" 
           class="bottom-frame">
    {% else %}
      <div style="position: absolute; top: 0; right: 0; width: 60%; height: 100%; background: linear-gradient(45deg, #f0f0f0 25%, transparent 25%), linear-gradient(-45deg, #f0f0f0 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #f0f0f0 75%), linear-gradient(-45deg, transparent 75%, #f0f0f0 75%); background-size: 20px 20px; background-position: 0 0, 0 10px, 10px -10px, -10px 0px; z-index: 1;"></div>
    {% endif %}
    
    <div class="main-content">
      <h1 class="title">{{ section.settings.title_text }}</h1>
      <p class="subtitle">{{ section.settings.subtitle_text }}</p>
      
      {% if section.settings.shop_button_link != blank %}
        <a href="{{ section.settings.shop_button_link }}" class="shop-button">
          {{ section.settings.shop_button_text }}
        </a>
      {% else %}
        <button class="shop-button">{{ section.settings.shop_button_text }}</button>
      {% endif %}
      
      {% if section.settings.additional_subtitle_text != blank %}
        <div class="additional-content">
          <p>{{ section.settings.additional_subtitle_text }}</p>
        </div>
      {% endif %}
      
      {% if section.settings.additional_shop_button_image != blank %}
        <div class="additional-content">
          <img src="{{ section.settings.additional_shop_button_image | image_url }}" 
               alt="Additional Shop Button Image" 
               class="additional-image">
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "top_frame_image",
      "label": "Top Frame Image",
      "info": "Frame with items like glasses, compass, etc. that appears behind the header content. Recommended dimensions: 1440x195"
    },
    {
      "type": "image_picker",
      "id": "bottom_frame_image",
      "label": "Bottom Frame Image", 
      "info": "Frame with items that appears beside 'The Gift Guide' content. Recommended dimensions: 864x195"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Name",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "tagline_text",
      "label": "Tagline Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "choose_button_text",
      "label": "Choose Gift Button Text",
      "default": "CHOOSE GIFT →"
    },
    {
      "type": "url",
      "id": "choose_button_link",
      "label": "Choose Gift Button Link"
    },
    {
      "type": "text",
      "id": "title_text",
      "label": "Main Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "subtitle_text",
      "label": "Subtitle Text",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "textarea",
      "id": "additional_subtitle_text",
      "label": "Additional Subtitle Text",
      "info": "Optional text to add below the subtitle."
    },
    {
      "type": "text",
      "id": "shop_button_text",
      "label": "Shop Now Button Text",
      "default": "SHOP NOW →"
    },
    {
      "type": "image_picker",
      "id": "additional_shop_button_image",
      "label": "Additional Shop Button Image",
      "info": "Optional image to add below the shop button."
    },
    {
      "type": "url",
      "id": "shop_button_link",
      "label": "Shop Now Button Link"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}