{%- style -%}
.gift-guide-banner{
  position:relative;
  height:390px;
  max-width:1440px;
  margin:0 auto;
  overflow:hidden;
  background:#ffffff;
}

/* --- NEW: two background images --- */
.bg-top,
.bg-left-bottom{
  position:absolute;
  object-fit:cover;
}
.bg-top{
  top:0;
  left:0;
  width:100%;
  height:100px;            /* height of top-row */
}
.bg-left-bottom{
  bottom:0;
  left:0;
  width:60%;               /* tweak as needed */
  height:290px;            /* 390 - 100 = 290 */
}

/* everything else stays identical */
.gift-guide-content{
  position:relative;
  z-index:1;
  height:100%;
  display:grid;
  grid-template-columns:repeat(5,1fr);
  grid-template-rows:repeat(4,1fr);
  gap:10px;
  padding:10px;
}
.top-row{
  grid-column:1 / span 5;
  grid-row:1;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:0 20px;
}
.main-content{
  grid-column:1 / span 3;
  grid-row:2 / span 3;
  padding:20px;
  background:rgba(255,255,255,.8);
}
/* … keep the rest of your existing CSS … */
{%- endstyle -%}

<div class="gift-guide-banner">
  <!-- NEW: two background images -->
  {%- if section.settings.bg_top != blank -%}
    <img src="{{ section.settings.bg_top | image_url: width: 1440 }}" alt="" class="bg-top" loading="lazy">
  {%- endif -%}
  {%- if section.settings.bg_left_bottom != blank -%}
    <img src="{{ section.settings.bg_left_bottom | image_url: width: 864 }}" alt="" class="bg-left-bottom" loading="lazy">
  {%- endif -%}

  <!-- existing content grid -->
  <div class="gift-guide-content">
    <div class="top-row">
      <div class="brand-name">{{ section.settings.brand_text }}</div>
      <div class="tagline">{{ section.settings.tagline_text }}</div>
      …
    </div>
    <div class="main-content">
      <h1 class="title">{{ section.settings.title_text }}</h1>
      …
    </div>
    <div class="image-1"></div>
    <div class="image-2"></div>
    <div class="image-3"></div>
    <div class="image-4"></div>
  </div>
</div>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_top",
      "label": "Background Image — Top",
      "info": "Full-width image behind the header row (1440×100 recommended)"
    },
    {
      "type": "image_picker",
      "id": "bg_left_bottom",
      "label": "Background Image — Left Bottom",
      "info": "Image behind the main content block (864×290 recommended)"
    },
    /* keep the rest of your existing settings … */
  ],
  "presets": [
    { "name": "Gift Guide Banner" }
  ]
}
{% endschema %}