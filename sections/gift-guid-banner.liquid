{%- style -%}
.holiday-gift-section{
  position:relative;
  max-width:100%;
  margin:0 auto;
  background:#ffffff;
  border:1px solid #e0e0e0;  overflow:hidden;
}

/* --- HEADER BAR --- */
.header-content-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:15px 40px;
  background:#ffffff;
  border-bottom:1px solid #f0f0f0;
  position:relative;
}

.brand-title{
  font-size:20px;
  font-weight:bold;
  text-transform:uppercase;
  color:#000;
}

.header-tagline{
  font-size:16px;
  color:#000;
}

/* --- HAMBURGER MENU --- */
.hamburger-menu{
  display:none;
  flex-direction:column;
  cursor:pointer;
  padding:8px;
  z-index:1001;
}

.hamburger-line{
  width:25px;
  height:3px;
  background:#000;
  margin:3px 0;
  transition:all 0.3s ease;
  border-radius:2px;
}

.hamburger-menu.active .hamburger-line:nth-child(1){
  transform:rotate(45deg) translate(5px, 5px);
}

.hamburger-menu.active .hamburger-line:nth-child(2){
  opacity:0;
}

.hamburger-menu.active .hamburger-line:nth-child(3){
  transform:rotate(-45deg) translate(7px, -6px);
}

/* Ensure hamburger is always black */
.hamburger-menu .hamburger-line{
  background:#000 !important;
}

/* Mobile Menu Overlay */
.mobile-menu-overlay{
  display:none;
  position:fixed;
  top:0;
  left:0;
  width:100%;
  height:100%;
  background:rgba(0,0,0,0.8);
  z-index:999;
  opacity:0;
  transition:opacity 0.3s ease;
}

.mobile-menu-overlay.active{
  opacity:1;
}

/* Mobile Menu Content */
.mobile-menu-content{
  position:fixed;
  top:0;
  right:-100%;
  width:300px;
  height:100%;
  background:#fff;
  z-index:1000;
  padding:80px 30px 30px;
  transition:right 0.3s ease;
  box-shadow:-5px 0 15px rgba(0,0,0,0.1);
  overflow-y:auto;
}

.mobile-menu-content.active{
  right:0;
}

.mobile-menu-header{
  text-align:center;
  margin-bottom:40px;
  padding-bottom:20px;
  border-bottom:1px solid #f0f0f0;
}

.mobile-menu-title{
  font-size:24px;
  font-weight:bold;
  color:#000;
  margin-bottom:10px;
}

.mobile-menu-tagline{
  font-size:16px;
  color:#666;
  line-height:1.4;
}

.mobile-menu-actions{
  display:flex;
  flex-direction:column;
  gap:20px;
}

.mobile-menu-actions .gift-choose-btn,
.mobile-menu-actions .shop-now-btn{
  width:100%;
  text-align:center;
  padding:16px 24px;
  font-size:16px;
}

/* --- FRAMES: full-width auto --- */
.header-area,
.content-area{
  height:300px;
  position:relative;
  overflow:hidden;
}
.header-frame-img{
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:100%;
  object-fit:cover;
}
.content-frame-img{
  position:absolute;
  top:0;
  right:0;
  width:calc(40% - 30px);   /* 40 % of area, minus left text-card offset */
  height:100%;
  object-fit:cover;
}
/* --- TEXT BOX --- */
.text-content-box{
  position:absolute;
  top:50%;
  left:30px;
  transform:translateY(-50%);
  width:60%;
  max-width:600px;
  background:rgba(255,255,255,.98);
  padding:40px;
  box-shadow:0 4px 12px rgba(0,0,0,.12);
}
.main-heading{
  font-size:48px;
  font-weight:bold;
  line-height:1.1;
  margin:0 0 15px;
}
.description-text{
  font-size:18px;
  margin:0 0 20px;
  color:#333;
}

/* --- SHOP NOW BUTTON POSITIONING --- */
.shop-now-btn{
  position:absolute;
  bottom:20px;
  left:50%;
  transform:translateX(-50%);
  z-index:10;
  padding:16px 32px;
  font-size:16px;
  border-radius:6px;
}

/* --- BUTTONS: left→right reveal --- */
.gift-choose-btn,
.shop-now-btn{
  padding:12px 24px;
  font-weight:bold;
  text-decoration:none;
  display:inline-block;
  cursor:pointer;
  border:none;
  background-size:200% 100%;
  transition:background-position .4s ease, color .4s ease;
}
/* CHOOSE GIFT  yellow→black */
.gift-choose-btn{
  color:#000;
  background-image:linear-gradient(to right, #000 0%, #000 50%, #ffff00 50%, #ffff00 100%);
  background-position:100% 0;
}
.gift-choose-btn:hover{
  background-position:0 0;
  color:#ffff00;
}
.sustainable-line{
  font-size:14px;
  color:#666;
  margin-top:20px;
  text-align:center;
  padding:15px 20px;
  background:#f8f8f8;
  border-top:1px solid #e0e0e0;
}
/* SHOP NOW  black→yellow */
.shop-now-btn{
  color:#fff;
  background-image:linear-gradient(to right, #ffff00 0%, #ffff00 50%, #000 50%, #000 100%);
  background-position:100% 0;
}
.shop-now-btn:hover{
  background-position:0 0;
  color:#000;
}

/* --- RESPONSIVE --- */
@media(max-width:1024px){
  .header-content-row{
    padding:15px 25px;
  }
  
  .text-content-box{
    padding:30px;
    left:20px;
  }
  
  .main-heading{
    font-size:42px;
  }
  
  .description-text{
    font-size:17px;
  }
  
  .content-area{
    height:280px;
  }
}

@media(max-width:768px){
  .holiday-gift-section{height:auto;}
  
  .header-content-row{
    padding:15px 20px;
    position:relative;
  }
  
  /* Hide desktop elements on mobile */
  .header-tagline,
  .gift-choose-btn{
    display:none;
  }
  
  /* Show hamburger menu on mobile */
  .hamburger-menu{
    display:flex;
  }
  
  /* Mobile layout: Single column, centered content */
  .holiday-gift-section{
    display:flex;
    flex-direction:column;
    text-align:center;
  }
  
  /* Main Content Area - Full width, centered */
  .content-area{
    height:auto;
    position:static;
    order:1;
    width:100%;
    padding:40px 20px;
    background:#ffffff;
  }
  
  .text-content-box{
    position:static;
    width:100%;
    max-width:none;
    margin:0;
    padding:0;
    transform:none;
    box-shadow:none;
    background:transparent;
    text-align:center;
  }
  
  /* Hide Side Frame Image on mobile */
  .content-frame-img{
    display:none;
  }
  
  /* Header Frame Image - Full width below content */
  .header-area{
    height:auto;
    position:relative;
    order:2;
    margin-top:0;
    width:100%;
  }
  
  .header-frame-img{
    position:static;
    width:100%;
    height:auto;
    opacity:1;
    max-height:250px;
    object-fit:cover;
    display:block;
  }
  
  /* Typography - Centered and optimized for mobile */
  .main-heading{
    font-size:42px;
    text-align:center;
    margin:0 0 20px 0;
    line-height:1.2;
  }
  
  .description-text{
    font-size:18px;
    text-align:center;
    margin:0 0 30px 0;
    line-height:1.5;
    color:#333;
  }
  
  /* SHOP NOW Button - Positioned over Header Frame Image */
  .shop-now-btn{
    position:absolute;
    bottom:20px;
    left:50%;
    transform:translateX(-50%);
    display:inline-block;
    margin:0;
    text-align:center;
    max-width:250px;
    padding:16px 32px;
    font-size:16px;
    border-radius:6px;
    z-index:10;
  }
  
  /* Mobile sustainable text styling */
  .sustainable-line{
    margin-top:20px;
    padding:20px;
    font-size:14px;
    background:#f8f8f8;
    border-top:1px solid #e0e0e0;
    text-align:center;
    order:3;
  }
}

@media(max-width:480px){
  .header-content-row{
    padding:12px 15px;
  }
  
  .brand-title{
    font-size:18px;
  }
  
  .content-area{
    padding:30px 15px;
  }
  
  .main-heading{
    font-size:36px;
    margin:0 0 18px 0;
  }
  
  .description-text{
    font-size:16px;
    margin:0 0 25px 0;
  }
  
  .shop-now-btn{
    max-width:220px;
    padding:14px 28px;
    font-size:15px;
    bottom:15px;
  }
  
  .header-frame-img{
    max-height:200px;
  }
  
  .sustainable-line{
    padding:18px 15px;
    font-size:13px;
    margin-top:15px;
  }
  
  .mobile-menu-content{
    width:280px;
    padding:70px 20px 20px;
  }
  
  .mobile-menu-title{
    font-size:22px;
  }
  
  .mobile-menu-tagline{
    font-size:15px;
  }
}

@media(max-width:360px){
  .header-content-row{
    padding:10px 12px;
  }
  
  .brand-title{
    font-size:16px;
  }
  
  .content-area{
    padding:25px 12px;
  }
  
  .main-heading{
    font-size:30px;
    margin:0 0 15px 0;
  }
  
  .description-text{
    font-size:15px;
    margin:0 0 20px 0;
  }
  
  .shop-now-btn{
    max-width:200px;
    padding:12px 24px;
    font-size:14px;
    bottom:12px;
  }
  
  .header-frame-img{
    max-height:180px;
  }
  
  .sustainable-line{
    padding:15px 12px;
    font-size:12px;
    margin-top:12px;
  }
  
  .mobile-menu-content{
    width:100%;
    right:-100%;
  }
  
  .mobile-menu-content.active{
    right:0;
  }
}
{%- endstyle -%}

<!-- ---------------- MARK-UP ---------------- -->
<div class="holiday-gift-section">
  <!-- Header bar -->
  <div class="header-content-row">
    <div class="brand-title">{{ section.settings.brand_name | default: 'TISSO VISON' }}</div>
    <div class="header-tagline">{{ section.settings.header_tagline | default: 'Find the ideal gift for your loved ones.' }}</div>
    {% if section.settings.choose_gift_url != blank %}
      <a href="{{ section.settings.choose_gift_url }}" class="gift-choose-btn">{{ section.settings.choose_gift_text | default: 'CHOOSE GIFT →' }}</a>
    {% else %}
      <button class="gift-choose-btn">{{ section.settings.choose_gift_text | default: 'CHOOSE GIFT →' }}</button>
    {% endif %}
    
    <!-- Hamburger Menu for Mobile -->
    <div class="hamburger-menu" id="hamburger-menu">
      <div class="hamburger-line"></div>
      <div class="hamburger-line"></div>
      <div class="hamburger-line"></div>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div class="mobile-menu-overlay" id="mobile-menu-overlay"></div>
  
  <!-- Mobile Menu Content -->
  <div class="mobile-menu-content" id="mobile-menu-content">
    <div class="mobile-menu-header">
      <div class="mobile-menu-title">{{ section.settings.brand_name | default: 'TISSO VISON' }}</div>
      <div class="mobile-menu-tagline">{{ section.settings.header_tagline | default: 'Find the ideal gift for your loved ones.' }}</div>
    </div>
    
    <div class="mobile-menu-actions">
      {% if section.settings.choose_gift_url != blank %}
        <a href="{{ section.settings.choose_gift_url }}" class="gift-choose-btn">{{ section.settings.choose_gift_text | default: 'CHOOSE GIFT →' }}</a>
      {% else %}
        <button class="gift-choose-btn">{{ section.settings.choose_gift_text | default: 'CHOOSE GIFT →' }}</button>
      {% endif %}
      
      {% if section.settings.shop_now_url != blank %}
        <a href="{{ section.settings.shop_now_url }}" class="shop-now-btn">{{ section.settings.shop_now_text | default: 'SHOP NOW →' }}</a>
      {% else %}
        <button class="shop-now-btn">{{ section.settings.shop_now_text | default: 'SHOP NOW →' }}</button>
      {% endif %}
    </div>
  </div>

  <!-- Top frame image -->
  <div class="header-area">
    {% if section.settings.header_frame != blank %}
      <img src="{{ section.settings.header_frame | image_url: width: 1440, height: 195 }}" alt="" class="header-frame-img" loading="lazy">
    {% endif %}
  </div>

  <!-- Bottom frame image + text -->
  <div class="content-area">
    {% if section.settings.side_frame != blank %}
      <img src="{{ section.settings.side_frame | image_url: width: 936, height: 195 }}" alt="" class="content-frame-img" loading="lazy">
    {% endif %}

    <div class="text-content-box">
      <h1 class="main-heading">{{ section.settings.main_title | default: 'The Gift Guide' }}</h1>
      <p class="description-text">{{ section.settings.description | default: 'Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.' }}</p>

      {% if section.settings.shop_now_url != blank %}
        <a href="{{ section.settings.shop_now_url }}" class="shop-now-btn">{{ section.settings.shop_now_text | default: 'SHOP NOW →' }}</a>
      {% else %}
        <button class="shop-now-btn">{{ section.settings.shop_now_text | default: 'SHOP NOW →' }}</button>
      {% endif %}

    </div>
  </div>
  {% if section.settings.sustainable_text != blank %}
    <p class="sustainable-line">{{ section.settings.sustainable_text }}</p>
  {% endif %}
</div>

<!-- Mobile Menu JavaScript -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const hamburgerMenu = document.getElementById('hamburger-menu');
  const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
  const mobileMenuContent = document.getElementById('mobile-menu-content');
  
  function toggleMobileMenu() {
    const isActive = hamburgerMenu.classList.contains('active');
    
    if (isActive) {
      // Close menu
      hamburgerMenu.classList.remove('active');
      mobileMenuOverlay.classList.remove('active');
      mobileMenuContent.classList.remove('active');
      document.body.style.overflow = '';
    } else {
      // Open menu
      hamburgerMenu.classList.add('active');
      mobileMenuOverlay.classList.add('active');
      mobileMenuContent.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  }
  
  // Toggle menu on hamburger click
  hamburgerMenu.addEventListener('click', toggleMobileMenu);
  
  // Close menu on overlay click
  mobileMenuOverlay.addEventListener('click', toggleMobileMenu);
  
  // Close menu on escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && hamburgerMenu.classList.contains('active')) {
      toggleMobileMenu();
    }
  });
  
  // Close menu on window resize (if switching from mobile to desktop)
  window.addEventListener('resize', function() {
    if (window.innerWidth > 768 && hamburgerMenu.classList.contains('active')) {
      toggleMobileMenu();
    }
  });
});
</script>

{% schema %}
{
  "name": "Holiday Gift Banner",
  "class": "holiday-gift-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Frame Images"
    },
    {
      "type": "image_picker",
      "id": "header_frame",
      "label": "Header Frame Image",
      "info": "Frame with decorative items for the top section (auto-width, 195px height)"
    },
    {
      "type": "image_picker",
      "id": "side_frame",
      "label": "Side Frame Image",
      "info": "Frame with decorative items for the side of main content (auto-width, 195px height)"
    },
    {
      "type": "select",
      "id": "frame_fit",
      "label": "Frame Image Fit",
      "default": "cover",
      "options": [
        { "value": "cover",   "label": "Cover (crop to fill)" },
        { "value": "contain", "label": "Contain (full image, letter-box)" },
        { "value": "fill",    "label": "Fill (stretch)" },
        { "value": "scale-down", "label": "Scale Down (never enlarge)" }
      ]
    },
    {
      "type": "header",
      "content": "Header Content"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "header_tagline",
      "label": "Header Tagline",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "choose_gift_text",
      "label": "Choose Gift Button Text",
      "default": "CHOOSE GIFT →"
    },
    {
      "type": "url",
      "id": "choose_gift_url",
      "label": "Choose Gift Button URL"
    },
    {
      "type": "header",
      "content": "Main Content"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "shop_now_text",
      "label": "Shop Now Button Text",
      "default": "SHOP NOW →"
    },
    {
      "type": "url",
      "id": "shop_now_url",
      "label": "Shop Now Button URL"
    },
    {
      "type": "textarea",
      "id": "sustainable_text",
      "label": "Sustainable / Extra Line",
      "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR"
    },
    {
      "type": "image_picker",
      "id": "extra_image",
      "label": "Additional Image",
      "info": "Optional image below the shop button"
    }
  ],
  "presets": [
    {
      "name": "Holiday Gift Banner – Centered"
    }
  ]
}
{% endschema %}