{%- style -%}
.gift-guide-banner {
  background-color: #ffffff;
  position: relative;
  height: 390px;
  max-width: 1440px;
  margin: 0 auto;
  overflow: hidden;
}
.gift-guide-background {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
}
.gift-guide-content {
  position: relative;
  z-index: 1;
  height: 100%;
}
.top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 20px;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 2;
}
.brand-name {
  font-size: 20px;
  font-weight: bold;
  text-transform: uppercase;
}
.tagline {
  font-size: 16px;
}
.choose-button {
  background-color: #ffff00;
  color: #000000;
  padding: 10px 20px;
  border: none;
  cursor: pointer;
  font-weight: bold;
  transition: background-color 0.3s ease, color 0.3s ease;
}
.choose-button:hover {
  background-color: #000000;
  color: #ffff00;
}
.main-content {
  position: absolute;
  top: 50%;
  left: 20px;
  transform: translateY(-50%);
  z-index: 2;
  max-width: 400px;
}
.title {
  font-size: 48px;
  font-weight: bold;
  line-height: 1.1;
  margin: 0;
}
.subtitle {
  font-size: 18px;
  margin: 10px 0;
}
.shop-button {
  background: linear-gradient(to right, #ffff00 50%, #000000 50%);
  background-size: 200% 100%;
  background-position: right bottom;
  color: #ffffff;
  padding: 10px 20px;
  border: none;
  cursor: pointer;
  font-weight: bold;
  transition: background-position 0.3s ease, color 0.3s ease;
}
.shop-button:hover {
  background-position: left bottom;
  color: #000000;
}
{%- endstyle -%}

<div class="gift-guide-banner">
  <div class="gift-guide-content">
    {% if section.settings.background_image != blank %}
      <img src="{{ section.settings.background_image | image_url: width: 1440 }}" alt="Background Image" loading="lazy" width="1440" height="390" class="gift-guide-background">
    {% else %}
      <div style="width: 100%; height: 390px; background-color: #f0f0f0;"></div>
    {% endif %}
    <div class="top-row">
      <div class="brand-name">{{ section.settings.brand_text }}</div>
      <div class="tagline">{{ section.settings.tagline_text }}</div>
      {% if section.settings.choose_button_link != blank %}
        <a href="{{ section.settings.choose_button_link }}" class="choose-button">{{ section.settings.choose_button_text }}</a>
      {% else %}
        <button class="choose-button">{{ section.settings.choose_button_text }}</button>
      {% endif %}
    </div>
    <div class="main-content">
      <h1 class="title">{{ section.settings.title_text }}</h1>
      <p class="subtitle">{{ section.settings.subtitle_text }}</p>
      {% if section.settings.shop_button_link != blank %}
        <a href="{{ section.settings.shop_button_link }}" class="shop-button">{{ section.settings.shop_button_text }}</a>
      {% else %}
        <button class="shop-button">{{ section.settings.shop_button_text }}</button>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image",
      "info": "Recommended dimensions: 1440x390. This is the frame with items like glasses, compass, etc."
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Name",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "tagline_text",
      "label": "Tagline Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "choose_button_text",
      "label": "Choose Gift Button Text",
      "default": "CHOOSE GIFT →"
    },
    {
      "type": "url",
      "id": "choose_button_link",
      "label": "Choose Gift Button Link"
    },
    {
      "type": "text",
      "id": "title_text",
      "label": "Main Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "subtitle_text",
      "label": "Subtitle Text",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "shop_button_text",
      "label": "Shop Now Button Text",
      "default": "SHOP NOW →"
    },
    {
      "type": "url",
      "id": "shop_button_link",
      "label": "Shop Now Button Link"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}