{% comment %}  Hero Banner – two responsive frames  {% endcomment %}

{%- style -%}
/* ----------  RESET / BASE  ---------- */
.hero-banner{
  position:relative;
  width:100%;
  overflow:hidden;
  background:#f8f7f4;
}
.hero-banner__frame{
  display:block;
  width:100%;
  height:auto;
}

/* ----------  DESKTOP FRAME (890×402)  ---------- */
@media (max-width:1023px){
  .hero-banner__desktop{display:none;}
}
@media (min-width:1024px){
  .hero-banner__mobile{display:none;}
}

/* ----------  TEXT LAYER  ---------- */
.hero-banner__txt{
  position:absolute;
  inset:0;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  pointer-events:none;
}
.hero-banner__eyebrow{
  font-size:clamp(.875rem,1.4vw,1rem);
  letter-spacing:.12em;
  text-transform:uppercase;
  margin:0 0 12px;
}
.hero-banner__headline{
  font-size:clamp(1.6rem,4vw,3.2rem);
  line-height:1.15;
  max-width:22ch;
  margin:0 0 24px;
  text-align:center;
}
.hero-banner__buttons{
  display:flex;
  gap:20px;
  flex-wrap:wrap;
  justify-content:center;
}
.btn{
  pointer-events:auto;
  padding:14px 32px;
  border-radius:4px;
  font-weight:600;
  text-decoration:none;
  transform:scale(1);
  transition:transform .2s ease-out;
}
.btn:hover{
  transform:scale(1.1); /* exact Figma spec */
}
.btn--primary{
  background:#111;
  color:#fff;
}
.btn--secondary{
  background:transparent;
  border:2px solid #111;
  color:#111;
}
{%- endstyle -%}

<section class="hero-banner">
  <!-- 1440×390  -->
  <img class="hero-banner__frame hero-banner__mobile"
       src="{{ section.settings.img_mobile | image_url: width: 1440 }}"
       alt="{{ section.settings.img_mobile.alt | escape }}"
       width="1440" height="390">

  <!-- 890×402  -->
  <img class="hero-banner__frame hero-banner__desktop"
       src="{{ section.settings.img_desktop | image_url: width: 890 }}"
       alt="{{ section.settings.img_desktop.alt | escape }}"
       width="890" height="402">

  <!-- Editable text overlay -->
  <div class="hero-banner__txt">
    <p class="hero-banner__eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="hero-banner__headline">{{ section.settings.headline }}</h1>

    <div class="hero-banner__buttons">
      <a class="btn btn--primary"
         href="{{ section.settings.primary_link }}">
        {{ section.settings.primary_text }}
      </a>

      <a class="btn btn--secondary"
         href="{{ section.settings.secondary_link }}">
        {{ section.settings.secondary_text }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "img_mobile",
      "label": "Frame 1 – 1440×390 (Mobile / Default)"
    },
    {
      "type": "image_picker",
      "id": "img_desktop",
      "label": "Frame 2 – 890×402 (Desktop)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (red box 1)",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline (red box 2)",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "primary_text",
      "label": "Primary CTA text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Secondary CTA text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary CTA link"
    }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}