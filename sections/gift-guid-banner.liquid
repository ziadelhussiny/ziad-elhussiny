{%- style -%}
.gift-guide-banner {
  background-color: #ffffff;
  position: relative;
  height: 390px;
  max-width: 1440px;
  margin: 0 auto;
  overflow: hidden;
}

.top-section {
  height: 195px; /* Half of 390px for the top frame */
  position: relative;
  overflow: hidden;
}
.top-background {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  object-fit: cover;
}
.top-content {
  position: relative;
  z-index: 1;
  height: 100%;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap: 10px;
  padding: 10px;
}
.top-row {
  grid-column: 1 / span 5;
  grid-row: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20px;
}
.brand-name {
  font-size: 20px;
  font-weight: bold;
  text-transform: uppercase;
}
.tagline {
  font-size: 16px;
}
.choose-button {
  background-color: #ffff00;
  color: #000000;
  padding: 10px 20px;
  border: none;
  cursor: pointer;
  font-weight: bold;
  transition: background-color 0.3s ease, color 0.3s ease;
}
.choose-button:hover {
  background-color: #000000;
  color: #ffff00;
}
.image-1 { grid-column: 4; grid-row: 1 / span 2; }
.image-2 { grid-column: 5; grid-row: 1 / span 2; }

.bottom-section {
  height: 195px; /* Half of 390px for the bottom frame */
  position: relative;
  overflow: hidden;
}
.bottom-background {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  object-fit: cover;
}
.bottom-content {
  position: relative;
  z-index: 1;
  height: 100%;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap: 10px;
  padding: 10px;
}
.main-content {
  grid-column: 1 / span 3;
  grid-row: 1 / span 2;
  padding: 20px;
  background-color: rgba(255, 255, 255, 0.8);
}
.title {
  font-size: 48px;
  font-weight: bold;
  line-height: 1.1;
  margin: 0;
}
.subtitle {
  font-size: 18px;
  margin: 10px 0;
}
.shop-button {
  background: linear-gradient(to right, #ffff00 50%, #000000 50%);
  background-size: 200% 100%;
  background-position: right bottom;
  color: #ffffff;
  padding: 10px 20px;
  border: none;
  cursor: pointer;
  font-weight: bold;
  transition: background-position 0.3s ease, color 0.3s ease;
}
.shop-button:hover {
  background-position: left bottom;
  color: #000000;
}
.image-3 { grid-column: 4; grid-row: 1 / span 2; }
.image-4 { grid-column: 5; grid-row: 1 / span 2; }

.additional-content {
  margin-top: 10px;
}
.additional-image {
  max-width: 100%;
  height: auto;
}
{%- endstyle -%}

<div class="gift-guide-banner">
  <div class="top-section">
    {% if section.settings.top_background_image != blank %}
      <img src="{{ section.settings.top_background_image | image_url: width: 1440 }}" alt="Top Background Image" loading="lazy" width="1440" height="195" class="top-background">
    {% else %}
      <div style="width: 100%; height: 195px; background-color: #f0f0f0;"></div>
    {% endif %}
    <div class="top-content">
      <div class="top-row">
        <div class="brand-name">{{ section.settings.brand_text }}</div>
        <div class="tagline">{{ section.settings.tagline_text }}</div>
        {% if section.settings.choose_button_link != blank %}
          <a href="{{ section.settings.choose_button_link }}" class="choose-button">{{ section.settings.choose_button_text }}</a>
        {% else %}
          <button class="choose-button">{{ section.settings.choose_button_text }}</button>
        {% endif %}
      </div>
      <div class="image-1"></div>
      <div class="image-2"></div>
      {% if section.settings.additional_tagline_image != blank %}
        <div class="additional-content">
          <img src="{{ section.settings.additional_tagline_image | image_url }}" alt="Additional Tagline Image" class="additional-image">
        </div>
      {% endif %}
    </div>
  </div>
  <div class="bottom-section">
    {% if section.settings.bottom_background_image != blank %}
      <img src="{{ section.settings.bottom_background_image | image_url: width: 1440 }}" alt="Bottom Background Image" loading="lazy" width="1440" height="195" class="bottom-background">
    {% else %}
      <div style="width: 100%; height: 195px; background-color: #f0f0f0;"></div>
    {% endif %}
    <div class="bottom-content">
      <div class="main-content">
        <h1 class="title">{{ section.settings.title_text }}</h1>
        <p class="subtitle">{{ section.settings.subtitle_text }}</p>
        {% if section.settings.shop_button_link != blank %}
          <a href="{{ section.settings.shop_button_link }}" class="shop-button">{{ section.settings.shop_button_text }}</a>
        {% else %}
          <button class="shop-button">{{ section.settings.shop_button_text }}</button>
        {% endif %}
        {% if section.settings.additional_subtitle_text != blank %}
          <div class="additional-content">
            <p>{{ section.settings.additional_subtitle_text }}</p>
          </div>
        {% endif %}
        {% if section.settings.additional_shop_button_image != blank %}
          <div class="additional-content">
            <img src="{{ section.settings.additional_shop_button_image | image_url }}" alt="Additional Shop Button Image" class="additional-image">
          </div>
        {% endif %}
      </div>
      <div class="image-3"></div>
      <div class="image-4"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "top_background_image",
      "label": "Top Background Image",
      "info": "Recommended dimensions: 1440x195. This is the top frame with items like glasses, compass, etc."
    },
    {
      "type": "image_picker",
      "id": "bottom_background_image",
      "label": "Bottom Background Image",
      "info": "Recommended dimensions: 1440x195. This is the bottom frame with items like glasses, compass, etc."
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Name",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "tagline_text",
      "label": "Tagline Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "image_picker",
      "id": "additional_tagline_image",
      "label": "Additional Tagline Image",
      "info": "Optional image to add below the tagline."
    },
    {
      "type": "text",
      "id": "choose_button_text",
      "label": "Choose Gift Button Text",
      "default": "CHOOSE GIFT →"
    },
    {
      "type": "url",
      "id": "choose_button_link",
      "label": "Choose Gift Button Link"
    },
    {
      "type": "text",
      "id": "title_text",
      "label": "Main Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "subtitle_text",
      "label": "Subtitle Text",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "textarea",
      "id": "additional_subtitle_text",
      "label": "Additional Subtitle Text",
      "info": "Optional text to add below the subtitle."
    },
    {
      "type": "text",
      "id": "shop_button_text",
      "label": "Shop Now Button Text",
      "default": "SHOP NOW →"
    },
    {
      "type": "image_picker",
      "id": "additional_shop_button_image",
      "label": "Additional Shop Button Image",
      "info": "Optional image to add below the shop button."
    },
    {
      "type": "url",
      "id": "shop_button_link",
      "label": "Shop Now Button Link"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}