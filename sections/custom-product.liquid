{%- liquid
  assign p1 = section.settings.product_1
  assign p2 = section.settings.product_2
  assign p3 = section.settings.product_3
  assign p4 = section.settings.product_4
  assign p5 = section.settings.product_5
  assign p6 = section.settings.product_6
  assign handles = p1 | append: '|' | append: p2 | append: '|' | append: p3 | append: '|' | append: p4 | append: '|' | append: p5 | append: '|' | append: p6 | split: '|' | compact | slice: 0, 6

  assign title    = section.settings.title | default: "The Gift Guide"
  assign desc     = section.settings.description | default: "Discover Joy: Your Ultimate Holiday Gift Destination."
  assign cta_text = section.settings.cta_text | default: "SHOP NOW"
  assign cta_url  = section.settings.cta_url | default: '#'

  assign btn_positions = section.settings.button_positions | default: "top-right,top-right,top-right,top-right,top-right,top-right" | split: ','
-%}

<section class="gift-guide-section">
  <div class="gift-guide-header">
    <h2>{{ title }}</h2>
    <p>{{ desc }}</p>
    <a href="{{ cta_url }}" class="cta-button">{{ cta_text }}</a>
  </div>

  <div class="product-grid">
    {%- for handle in handles -%}
      {%- assign product = all_products[handle] -%}
      {%- if product -%}
        {%- assign btn_pos = btn_positions[forloop.index0] | default: 'top-right' -%}
        <div class="product-card">
          <div class="img-wrap">
            <img src="{{ product.featured_image | img_url: '600x600' }}"
                 alt="{{ product.title }}" loading="lazy">
            <button class="quick-btn {{ btn_pos }}" 
                    data-id="{{ product.id }}" 
                    data-handle="{{ product.handle }}"
                    data-title="{{ product.title | escape }}"
                    data-price="{{ product.price | money_without_currency }}"
                    data-image="{{ product.featured_image | img_url: '400x400' }}">+</button>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<!-- Enhanced Modal -->
<div id="quick-modal" class="modal">
  <div class="modal-overlay"></div>
  <div class="modal-content">
    <button class="modal-close">&times;</button>
    <div id="modal-inner"></div>
  </div>
</div>

<style>
/*  (styles unchanged)  */
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const modal        = document.getElementById('quick-modal');
  const modalOverlay = modal.querySelector('.modal-overlay');
  const inner        = document.getElementById('modal-inner');
  const closeBtn     = modal.querySelector('.modal-close');
  let currentProduct = null;

  /* ---------- open modal ---------- */
  document.addEventListener('click', function (e) {
    if (!e.target.classList.contains('quick-btn')) return;
    e.preventDefault(); e.stopPropagation();

    const { id: productId, handle: productHandle, title, price, image } = e.target.dataset;

    inner.innerHTML = `
      <div style="padding:40px;text-align:center;">
        <div style="display:inline-block;width:30px;height:30px;border:3px solid #f3f3f3;border-top:3px solid #333;border-radius:50%;animation:spin 1s linear infinite;"></div>
        <p style="margin-top:15px;color:#666;">Loading product…</p>
      </div>`;
    modal.style.display = 'block';
    document.body.style.overflow = 'hidden';

    /* prefer handle fetch, fallback to id */
    const fetchPromise = productHandle
      ? fetch(`/products/${productHandle}.js`)
      : fetch(`/products/${productId}.js`);

    fetchPromise
      .then(r => { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(p => { currentProduct = p; renderModal(p); })
      .catch(err => {
        console.error(err);
        inner.innerHTML = `
          <div style="padding:40px;text-align:center;">
            <p style="color:#999;">Sorry, product details could not be loaded.</p>
            <button onclick="document.getElementById('quick-modal').style.display='none';document.body.style.overflow='';"
                    style="margin-top:15px;padding:10px 20px;background:#000;color:#fff;border:none;border-radius:4px;cursor:pointer;">Close</button>
          </div>`;
      });
  });

  /* ---------- close helpers ---------- */
  function closeModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
    currentProduct = null;
  }
  closeBtn.addEventListener('click', closeModal);
  modalOverlay.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

  /* ---------- render modal ---------- */
  function renderModal(product) {
    if (!product) { inner.innerHTML = '<div style="padding:40px;color:#999;">Product unavailable.</div>'; return; }

    const imageUrl = product.images?.[0] || product.featured_image;
    let   price    = (product.price_min || product.price) / 100;
    price          = price.toFixed(2);

    /* Ensure every variant is available unless Shopify says otherwise */
    const variants = (product.variants || [{ id: product.id, title: 'Default', available: true }])
                     .map(v => ({...v, available: v.available !== false}));

    /* determine color vs size options */
    const optionNames = product.options || [];
    let colorOptions = [], sizeOptions = [];

    const colorKeywords = ['color','colour','red','blue','green','black','white','grey','gray','yellow','pink','purple','brown','orange'];
    const sizeKeywords  = ['size','xs','s','m','l','xl','xxl','small','medium','large','extra'];

    /* logic to split options */
    if (optionNames.length) {
      const o1 = [...new Set(variants.map(v => v.option1).filter(Boolean))];
      const o2 = [...new Set(variants.map(v => v.option2).filter(Boolean))];
      const o3 = [...new Set(variants.map(v => v.option3).filter(Boolean))];

      const name1 = (optionNames[0] || '').toLowerCase();
      const name2 = (optionNames[1] || '').toLowerCase();
      const name3 = (optionNames[2] || '').toLowerCase();

      if (colorKeywords.some(k => name1.includes(k))) {
        colorOptions = o1; sizeOptions = o2.length ? o2 : o3;
      } else if (sizeKeywords.some(k => name1.includes(k))) {
        sizeOptions = o1; colorOptions = o2.length ? o2 : o3;
      } else {
        /* fallback: guess based on values */
        const isO1Color = o1.some(v => colorKeywords.some(k => v.toLowerCase().includes(k)));
        const isO1Size  = o1.some(v => sizeKeywords.some(k => v.toLowerCase().includes(k)) || /^(xs|s|m|l|xl|xxl|\d+)$/i.test(v));
        if (isO1Color && !isO1Size)      { colorOptions = o1; sizeOptions = o2.length ? o2 : o3; }
        else if (isO1Size && !isO1Color) { sizeOptions  = o1; colorOptions = o2.length ? o2 : o3; }
        else                             { colorOptions = o1; sizeOptions = o2.length ? o2 : o3; }
      }
    }

    colorOptions = [...new Set(colorOptions)].filter(Boolean);
    sizeOptions  = [...new Set(sizeOptions)].filter(Boolean);

    const useSizeButtons = sizeOptions.length <= 6 && sizeOptions.every(s => s.length <= 3);

    inner.innerHTML = `
      <div class="modal-product">
        ${imageUrl ? `<img src="${imageUrl}" alt="${product.title}" class="modal-product-image">` : ''}
        <div class="modal-content-inner">
          <h3 class="modal-product-title">${product.title}</h3>
          <div class="modal-product-price">€${price}</div>
          ${product.description ? `<div class="modal-product-description">${product.description.substring(0,120)}${product.description.length>120?'...':''}</div>` : ''}

          <form id="add-to-cart-form" action="/cart/add" method="post">
            ${colorOptions.length > 1 ? `
              <div class="modal-form-group">
                <label class="modal-form-label">Color</label>
                <div class="modal-color-options" id="color-options">
                  ${colorOptions.map((c, i) => `
                    <div class="modal-color-option">
                      <button type="button" class="modal-color-btn ${i===0?'selected':''}" data-color="${c}">${c}</button>
                    </div>`).join('')}
                </div>
              </div>` : ''}

            ${sizeOptions.length > 1 ? `
              <div class="modal-form-group">
                <label class="modal-form-label">Size</label>
                ${useSizeButtons && sizeOptions.length <= 4 ? `
                  <div class="modal-size-button-style" id="size-button-container">
                    ${sizeOptions.map((s, i) => `
                      <button type="button" class="modal-size-btn ${i===0?'selected':''}" data-size="${s}">${s}</button>`).join('')}
                  </div>` : `
                  <div class="modal-size-wrapper">
                    <select class="modal-size-select" id="size-select" required>
                      <option value="" disabled ${sizeOptions.length ? 'selected' : ''}>Choose your size</option>
                      ${sizeOptions.map(s => `<option value="${s}">${s}</option>`).join('')}
                    </select>
                  </div>`}
              </div>` : ''}

            <input type="hidden" name="id" id="variant-id" value="${variants[0].id}">
            <div id="stock-message" class="modal-stock-message" style="display:none;"></div>
            <button type="submit" class="modal-add-to-cart" id="add-to-cart-btn">
              <span>ADD TO CART</span><span>→</span>
            </button>
          </form>
        </div>
      </div>`;

    setupFormInteractions(variants, colorOptions, sizeOptions);
  }

  /* ---------- form interactions ---------- */
  function setupFormInteractions(variants, colorOptions, sizeOptions) {
    const colorBtns = document.querySelectorAll('.modal-color-btn');
    const sizeBtns  = document.querySelectorAll('.modal-size-btn');
    const sizeSel   = document.getElementById('size-select');
    const variantIn = document.getElementById('variant-id');
    const stockMsg  = document.getElementById('stock-message');
    const addBtn    = document.getElementById('add-to-cart-btn');
    const form      = document.getElementById('add-to-cart-form');

    let selectedColor = colorOptions[0] || null;
    let selectedSize  = sizeOptions[0]  || null;

    colorBtns.forEach(btn => btn.addEventListener('click', e => {
      e.preventDefault();
      colorBtns.forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      selectedColor = btn.dataset.color;
      updateVariant();
    }));

    sizeBtns.forEach(btn => btn.addEventListener('click', e => {
      e.preventDefault();
      sizeBtns.forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      selectedSize = btn.dataset.size;
      updateVariant();
    }));

    if (sizeSel) sizeSel.addEventListener('change', () => { selectedSize = sizeSel.value; updateVariant(); });

    function updateVariant() {
      const variant = variants.find(v =>
        (!selectedColor || [v.option1, v.option2, v.option3].includes(selectedColor)) &&
        (!selectedSize  || [v.option1, v.option2, v.option3].includes(selectedSize))
      ) || variants[0];

      if (variant) {
        variantIn.value = variant.id;
        stockMsg.style.display = 'block';
        if (variant.available) {
          stockMsg.textContent = 'In stock';
          stockMsg.className   = 'modal-stock-message in-stock';
          addBtn.disabled = false;
          addBtn.innerHTML = '<span>ADD TO CART</span><span>→</span>';
        } else {
          stockMsg.textContent = 'Out of stock';
          stockMsg.className   = 'modal-stock-message out-of-stock';
          addBtn.disabled = true;
          addBtn.innerHTML = '<span>OUT OF STOCK</span>';
        }
      }
    }
    updateVariant();

    form.addEventListener('submit', e => {
      e.preventDefault();
      addBtn.disabled = true;
      addBtn.innerHTML = '<span>ADDING…</span>';
      fetch('/cart/add.js', { method: 'POST', body: new FormData(form) })
        .then(r => r.json())
        .then(() => {
          addBtn.innerHTML = '<span>ADDED!</span> <span>✓</span>';
          setTimeout(closeModal, 1000);
        })
        .catch(() => {
          alert('Error adding to cart.');
          addBtn.disabled = false;
          addBtn.innerHTML = '<span>ADD TO CART</span><span>→</span>';
        });
    });
  }

  /* ---------- spinner animation ---------- */
  const spinStyle = document.createElement('style');
  spinStyle.textContent = '@keyframes spin { 0%{transform:rotate(0deg)} 100%{transform:rotate(360deg)} }';
  document.head.appendChild(spinStyle);
});
</script>

{% schema %}
{
  "name": "Gift Guide",
  "settings": [
    { "type": "text",    "id": "title",       "label": "Section Title", "default": "The Gift Guide" },
    { "type": "textarea","id": "description", "label": "Description",   "default": "Discover Joy: Your Ultimate Holiday Gift Destination." },
    { "type": "text",    "id": "cta_text",    "label": "CTA Button Text", "default": "SHOP NOW" },
    { "type": "url",     "id": "cta_url",     "label": "CTA Button URL" },
    { "type": "text",    "id": "button_positions", "label": "Button Positions", "default": "top-right,top-right,top-right,top-right,top-right,top-right",
      "info": "Comma-separated positions: top-left, top-center, top-right, center-left, center, center-right, bottom-left, bottom-center, bottom-right" },
    { "type": "product", "id": "product_1", "label": "Product 1" },
    { "type": "product", "id": "product_2", "label": "Product 2" },
    { "type": "product", "id": "product_3", "label": "Product 3" },
    { "type": "product", "id": "product_4", "label": "Product 4" },
    { "type": "product", "id": "product_5", "label": "Product 5" },
    { "type": "product", "id": "product_6", "label": "Product 6" }
  ],
  "presets": [{ "name": "Gift Guide" }]
}
{% endschema %}