{%- liquid
  assign p1 = section.settings.product_1
  assign p2 = section.settings.product_2
  assign p3 = section.settings.product_3
  assign p4 = section.settings.product_4
  assign p5 = section.settings.product_5
  assign p6 = section.settings.product_6
  assign handles = p1 | append: '|' | append: p2 | append: '|' | append: p3 | append: '|' | append: p4 | append: '|' | append: p5 | append: '|' | append: p6 | split: '|' | compact | slice: 0, 6

  assign title    = section.settings.title | default: "The Gift Guide"
  assign desc     = section.settings.description | default: "Discover Joy: Your Ultimate Holiday Gift Destination."
  assign cta_text = section.settings.cta_text | default: "SHOP NOW"
  assign cta_url  = section.settings.cta_url | default: '#'

  assign btn_positions = section.settings.button_positions | default: "top-right,top-right,top-right,top-right,top-right,top-right" | split: ','
-%}

<section class="gift-guide-section">
  <div class="gift-guide-header">
    <h2>{{ title }}</h2>
    <p>{{ desc }}</p>
    <a href="{{ cta_url }}" class="cta-button">{{ cta_text }}</a>
  </div>

  <div class="product-grid">
    {%- for handle in handles -%}
      {%- assign product = all_products[handle] -%}
      {%- if product -%}
        {%- assign btn_pos = btn_positions[forloop.index0] | default: 'top-right' -%}
        <div class="product-card">
          <div class="img-wrap">
            <img src="{{ product.featured_image | img_url: '600x600' }}"
                 alt="{{ product.title }}" loading="lazy">
            <button class="quick-btn {{ btn_pos }}" 
                    data-id="{{ product.id }}" 
                    data-handle="{{ product.handle }}"
                    data-title="{{ product.title | escape }}"
                    data-price="{{ product.price | money_without_currency }}"
                    data-image="{{ product.featured_image | img_url: '400x400' }}">+</button>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<!-- Enhanced Modal with Exact Clone Design -->
<div id="quick-modal" class="modal">
  <div class="modal-overlay"></div>
  <div class="modal-content">
    <button class="modal-close">&times;</button>
    <div id="modal-inner"></div>
  </div>
</div>

<style>
/* Base Styles */
.gift-guide-section{max-width:1200px;margin:0 auto;padding:40px 20px;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;}
.gift-guide-header{text-align:center;margin-bottom:30px;}
.gift-guide-header h2{font-size:2.5rem;margin-bottom:15px;color:#333;font-weight:600;}
.gift-guide-header p{font-size:1.1rem;color:#666;margin-bottom:25px;}
.cta-button{display:inline-block;padding:14px 32px;background:#000;color:#fff;text-decoration:none;border-radius:6px;font-weight:600;text-transform:uppercase;transition:all 0.3s ease;letter-spacing:0.5px;}
.cta-button:hover{background:#333;transform:translateY(-1px);}

.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px;}
.product-card{position:relative;overflow:hidden;}
.img-wrap{position:relative;overflow:hidden;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.1);transition:all 0.3s ease;}
.img-wrap:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(0,0,0,0.15);}
.img-wrap img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;}

/* Button positioning classes */
.quick-btn{position:absolute;width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,0.95);color:#333;border:none;font-size:20px;cursor:pointer;line-height:1;font-weight:600;box-shadow:0 4px 16px rgba(0,0,0,0.2);transition:all 0.3s ease;z-index:5;backdrop-filter:blur(10px);}
.quick-btn:hover{background:#fff;transform:scale(1.1);box-shadow:0 6px 24px rgba(0,0,0,0.3);}

.quick-btn.top-left{top:15px;left:15px;}
.quick-btn.top-center{top:15px;left:50%;transform:translateX(-50%);}
.quick-btn.top-right{top:15px;right:15px;}
.quick-btn.center-left{top:50%;left:15px;transform:translateY(-50%);}
.quick-btn.center{top:50%;left:50%;transform:translate(-50%,-50%);}
.quick-btn.center-right{top:50%;right:15px;transform:translateY(-50%);}
.quick-btn.bottom-left{bottom:15px;left:15px;}
.quick-btn.bottom-center{bottom:15px;left:50%;transform:translateX(-50%);}
.quick-btn.bottom-right{bottom:15px;right:15px;}

/* Modal Design - EXACT Clone */
.modal{display:none;position:fixed;inset:0;z-index:10000;}
.modal-overlay{position:absolute;inset:0;background:rgba(0,0,0,0.6);}
.modal-content{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#fff;border-radius:0;width:90%;max-width:380px;max-height:90vh;overflow-y:auto;box-shadow:0 4px 20px rgba(0,0,0,0.25);}
.modal-close{position:absolute;top:12px;right:12px;background:none;border:none;font-size:18px;color:#666;cursor:pointer;z-index:1;width:24px;height:24px;display:flex;align-items:center;justify-content:center;font-weight:400;}
.modal-close:hover{color:#000;}

/* Modal Product Layout */
.modal-product{display:block;}
.modal-product-image{width:100%;height:200px;object-fit:cover;display:block;margin:0;}
.modal-content-inner{padding:20px;background:#fff;}
.modal-product-title{font-size:1.1rem;font-weight:600;color:#000;margin:0 0 6px 0;line-height:1.3;}
.modal-product-price{font-size:1rem;font-weight:400;color:#666;margin:0 0 12px 0;}
.modal-product-description{font-size:0.85rem;color:#666;line-height:1.4;margin:0 0 20px 0;}

/* Form Styles */
.modal-form-group{margin-bottom:16px;}
.modal-form-label{display:block;font-weight:600;color:#000;margin-bottom:8px;font-size:0.75rem;text-transform:uppercase;letter-spacing:1px;}

/* Color Selection - EXACT Clone Match */
.modal-color-options{display:grid;grid-template-columns:repeat(4, 1fr);gap:0;border:1px solid #ddd;border-radius:0;overflow:hidden;margin-bottom:0;}
.modal-color-option{position:relative;}
.modal-color-btn{width:100%;padding:10px 8px;border:none;background:#fff;color:#666;font-size:0.75rem;font-weight:400;cursor:pointer;transition:all 0.2s ease;text-align:center;min-height:40px;display:flex;align-items:center;justify-content:center;border-right:1px solid #ddd;}
.modal-color-btn:last-child{border-right:none;}
.modal-color-btn:hover{background:#f8f8f8;}
.modal-color-btn.selected{background:#2c3e50;color:#fff;}

/* Size Selection Dropdown - EXACT Clone Match */
.modal-size-wrapper{position:relative;margin-bottom:16px;}
.modal-size-select{width:100%;padding:12px 16px;border:1px solid #ddd;border-radius:0;font-size:0.85rem;color:#666;background:#fff;cursor:pointer;transition:border-color 0.2s ease;appearance:none;background-image:url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%23666' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");background-position:right 12px center;background-repeat:no-repeat;background-size:12px;padding-right:40px;min-height:44px;}
.modal-size-select:focus{outline:none;border-color:#666;}

/* Size Button Style - EXACT Clone Match */
.modal-size-button-style{display:grid;grid-template-columns:repeat(4, 1fr);gap:0;border:1px solid #ddd;border-radius:0;overflow:hidden;margin-bottom:16px;}
.modal-size-btn{width:100%;padding:10px 8px;border:none;background:#fff;color:#666;font-size:0.75rem;cursor:pointer;transition:all 0.2s ease;text-align:center;font-weight:400;min-height:40px;display:flex;align-items:center;justify-content:center;border-right:1px solid #ddd;}
.modal-size-btn:last-child{border-right:none;}
.modal-size-btn:hover{background:#f8f8f8;}
.modal-size-btn.selected{background:#2c3e50;color:#fff;}
.modal-size-btn:disabled{background:#f8f8f8;color:#ccc;cursor:not-allowed;}

/* Add to Cart Button - EXACT Clone Match */
.modal-add-to-cart{width:100%;padding:14px;background:#2c3e50;color:#fff;border:none;font-size:0.85rem;font-weight:600;text-transform:uppercase;border-radius:0;cursor:pointer;transition:background 0.3s ease;margin-top:16px;letter-spacing:1px;min-height:48px;}
.modal-add-to-cart:hover{background:#1a252f;}
.modal-add-to-cart:disabled{background:#ccc;cursor:not-allowed;}

/* Stock Messaging - EXACT Clone Match */
.modal-stock-message{padding:10px 16px;color:#666;font-size:0.8rem;text-align:center;margin-bottom:16px;border-radius:0;}
.modal-stock-message.in-stock{background:#d4edda;color:#155724;border:1px solid #c3e6cb;}
.modal-stock-message.out-of-stock{background:#f8d7da;color:#721c24;border:1px solid #f1b0b7;}

/* Loading Animation */
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
.loading-spinner{display:inline-block;width:30px;height:30px;border:3px solid #f3f4f6;border-top:3px solid #1f2937;border-radius:50%;animation:spin 1s linear infinite;}

/* Responsive Design */
@media (max-width: 768px) {
  .product-grid{grid-template-columns:repeat(2,1fr);gap:15px;}
  .gift-guide-header h2{font-size:2rem;}
  .modal-content{width:95%;max-width:400px;border-radius:8px;}
  .modal-content-inner{padding:20px;}
  .modal-product-image{height:180px;}
  .quick-btn{width:36px;height:36px;font-size:18px;}
}

@media (max-width: 480px) {
  .product-grid{grid-template-columns:1fr;gap:15px;}
  .quick-btn{width:32px;height:32px;font-size:16px;}
  .quick-btn.top-left,.quick-btn.center-left,.quick-btn.bottom-left{left:10px;}
  .quick-btn.top-right,.quick-btn.center-right,.quick-btn.bottom-right{right:10px;}
  .quick-btn.top-left,.quick-btn.top-center,.quick-btn.top-right{top:10px;}
  .quick-btn.bottom-left,.quick-btn.bottom-center,.quick-btn.bottom-right{bottom:10px;}
  .modal-content{width:98%;border-radius:6px;}
  .modal-content-inner{padding:16px;}
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const modal = document.getElementById('quick-modal');
  const modalOverlay = modal.querySelector('.modal-overlay');
  const inner = document.getElementById('modal-inner');
  const close = modal.querySelector('.modal-close');
  let currentProduct = null;

  console.log('Enhanced Gift Guide Modal Script Loaded');

  // Open modal
  document.addEventListener('click', function(e) {
    if (!e.target.classList.contains('quick-btn')) return;
    e.preventDefault();
    e.stopPropagation();

    const productId = e.target.dataset.id;
    const productHandle = e.target.dataset.handle;
    
    // Show loading with new design
    inner.innerHTML = `
      <div style="padding:60px 20px;text-align:center;">
        <div class="loading-spinner"></div>
        <p style="margin-top:20px;color:#6b7280;font-size:0.875rem;">Loading product...</p>
      </div>
    `;
    modal.style.display = 'block';
    document.body.style.overflow = 'hidden';

    // Fetch product data
    if (productId) {
      fetch(`/products/${productId}.js`)
        .then(r => {
          if (!r.ok) throw new Error('Product not found');
          return r.json();
        })
        .then(p => {
          currentProduct = p;
          renderModal(p);
        })
        .catch(err => {
          if (productHandle) {
            fetchByHandle(productHandle);
          } else {
            showError();
          }
        });
    } else if (productHandle) {
      fetchByHandle(productHandle);
    } else {
      showError();
    }
  });

  function fetchByHandle(handle) {
    fetch(`/products/${handle}.js`)
      .then(r => {
        if (!r.ok) throw new Error('Handle fetch failed');
        return r.json();
      })
      .then(p => {
        currentProduct = p;
        renderModal(p);
      })
      .catch(err => {
        showError();
      });
  }

  function showError() {
    inner.innerHTML = `
      <div style="padding:60px 20px;text-align:center;">
        <p style="color:#6b7280;margin-bottom:24px;font-size:0.875rem;">Sorry, product details could not be loaded.</p>
        <button onclick="document.getElementById('quick-modal').style.display='none'; document.body.style.overflow='';" 
                style="padding:12px 24px;background:#1f2937;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:0.875rem;font-weight:500;">
          Close
        </button>
      </div>
    `;
  }

  function closeModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
    currentProduct = null;
  }

  close.addEventListener('click', closeModal);
  modalOverlay.addEventListener('click', closeModal);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.style.display === 'block') {
      closeModal();
    }
  });

  function renderModal(product) {
    if (!product) {
      inner.innerHTML = '<div style="padding:60px 20px;text-align:center;color:#6b7280;font-size:0.875rem;">Product details unavailable.</div>';
      return;
    }

    // Handle price formatting
    let price = '0.00';
    if (product.price_min) {
      price = (product.price_min / 100).toFixed(2);
    } else if (product.price) {
      price = typeof product.price === 'string' ? product.price.replace(/[^\d.]/g, '') : (product.price / 100).toFixed(2);
    }

    const imageUrl = product.images && product.images[0] ? product.images[0] : product.featured_image;
    const variants = product.variants || [{ id: product.id, title: 'Default', available: true }];
    
    // Extract unique options
    const colors = [...new Set(variants.map(v => v.option1).filter(Boolean))];
    const sizes = [...new Set(variants.map(v => v.option2 || v.option3).filter(Boolean))];
    
    // Check if we should use button or dropdown for sizes
    const useSizeButtons = sizes.length <= 4 && sizes.every(size => size.length <= 3);

    inner.innerHTML = `
      <div class="modal-product">
        ${imageUrl ? `<img src="${imageUrl}" alt="${product.title}" class="modal-product-image">` : ''}
        <div class="modal-content-inner">
          <h3 class="modal-product-title">${product.title}</h3>
          <div class="modal-product-price">€${price}</div>
          ${product.description ? `<div class="modal-product-description">${product.description.substring(0, 120)}${product.description.length > 120 ? '...' : ''}</div>` : ''}
          
          <form id="add-to-cart-form" action="/cart/add" method="post">
            ${colors.length > 1 ? `
              <div class="modal-form-group">
                <label class="modal-form-label">Color</label>
                <div class="modal-color-options" id="color-options">
                  ${colors.map((color, index) => `
                    <div class="modal-color-option">
                      <button type="button" class="modal-color-btn ${index === 0 ? 'selected' : ''}" data-color="${color}">
                        ${color}
                      </button>
                    </div>
                  `).join('')}
                </div>
              </div>
            ` : ''}
            
            ${sizes.length > 1 ? `
              <div class="modal-form-group">
                <label class="modal-form-label">Size</label>
                ${useSizeButtons ? `
                  <div class="modal-size-button-style" id="size-button-container">
                    ${sizes.map((size, index) => `
                      <button type="button" class="modal-size-btn ${index === 0 ? 'selected' : ''}" data-size="${size}">
                        ${size}
                      </button>
                    `).join('')}
                  </div>
                ` : `
                  <div class="modal-size-wrapper">
                    <select class="modal-size-select" id="size-select" required>
                      <option value="">Choose your size</option>
                      ${sizes.map(size => `<option value="${size}">${size}</option>`).join('')}
                    </select>
                  </div>
                `}
              </div>
            ` : ''}
            
            <input type="hidden" name="id" id="variant-id" value="${variants[0].id}" required>
            
            <div id="stock-message" class="modal-stock-message" style="display:none;"></div>
            
            <button type="submit" class="modal-add-to-cart" id="add-to-cart-btn">
              ADD TO CART →
            </button>
          </form>
        </div>
      </div>
    `;

    setupFormInteractions(variants, useSizeButtons);
  }

  function setupFormInteractions(variants, useSizeButtons) {
    const colorBtns = document.querySelectorAll('.modal-color-btn');
    const sizeBtns = document.querySelectorAll('.modal-size-btn');
    const sizeSelect = document.getElementById('size-select');
    const variantInput = document.getElementById('variant-id');
    const stockMessage = document.getElementById('stock-message');
    const addBtn = document.getElementById('add-to-cart-btn');
    const form = document.getElementById('add-to-cart-form');

    let selectedColor = colorBtns.length > 0 ? colorBtns[0].dataset.color : null;
    let selectedSize = sizeBtns.length > 0 ? sizeBtns[0].dataset.size : null;

    // Color selection
    colorBtns.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        colorBtns.forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        selectedColor = btn.dataset.color;
        updateVariant();
      });
    });

    // Size button selection
    sizeBtns.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        sizeBtns.forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        selectedSize = btn.dataset.size;
        updateVariant();
      });
    });

    // Size dropdown selection
    if (sizeSelect) {
      sizeSelect.addEventListener('change', function() {
        selectedSize = sizeSelect.value;
        updateVariant();
      });
    }

    function updateVariant() {
      if (!variants || !Array.isArray(variants)) return;

      let variant = variants.find(v => {
        if (selectedColor && selectedSize) {
          return (v.option1 === selectedColor || v.option2 === selectedColor) && 
                 (v.option2 === selectedSize || v.option3 === selectedSize);
        } else if (selectedColor) {
          return v.option1 === selectedColor || v.option2 === selectedColor;
        } else if (selectedSize) {
          return v.option2 === selectedSize || v.option3 === selectedSize;
        }
        return true;
      });

      if (!variant) {
        variant = variants[0];
      }

      if (variant && variantInput) {
        variantInput.value = variant.id;
        updateStockDisplay(variant);
      }
    }

    function updateStockDisplay(variant) {
      if (!stockMessage || !addBtn) return;

      if (variant.available) {
        stockMessage.textContent = 'In stock';
        stockMessage.className = 'modal-stock-message in-stock';
        stockMessage.style.display = 'block';
        addBtn.disabled = false;
        addBtn.innerHTML = 'ADD TO CART →';
      } else {
        stockMessage.textContent = 'Out of stock';
        stockMessage.className = 'modal-stock-message out-of-stock';
        stockMessage.style.display = 'block';
        addBtn.disabled = true;
        addBtn.innerHTML = 'OUT OF STOCK';
      }
    }

    // Initialize variant
    updateVariant();

    // Form submission
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData(form);
        
        if (addBtn) {
          addBtn.innerHTML = 'ADDING...';
          addBtn.disabled = true;
        }

        fetch('/cart/add.js', {
          method: 'POST',
          body: formData
        })
        .then(response => response.json())
        .then(data => {
          if (addBtn) {
            addBtn.innerHTML = 'ADDED! ✓';
          }
          setTimeout(() => {
            closeModal();
          }, 1000);
        })
        .catch(error => {
          console.error('Error:', error);
          if (addBtn) {
            addBtn.innerHTML = 'ADD TO CART →';
            addBtn.disabled = false;
          }
          alert('Sorry, there was an error adding the product to cart.');
        });
      });
    }
  }
});
</script>

{% schema %}
{
  "name": "Gift Guide",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL"
    },
    {
      "type": "text",
      "id": "button_positions",
      "label": "Button Positions",
      "info": "Comma-separated positions for each product button: top-left, top-center, top-right, center-left, center, center-right, bottom-left, bottom-center, bottom-right",
      "default": "top-right,top-right,top-right,top-right,top-right,top-right"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    },
    {
      "type": "product",
      "id": "product_5",
      "label": "Product 5"
    },
    {
      "type": "product",
      "id": "product_6",
      "label": "Product 6"
    }
  ],
  "presets": [
    { "name": "Gift Guide" }
  ]
}
{% endschema %}