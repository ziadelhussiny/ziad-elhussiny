{%- liquid
  assign p1 = section.settings.product_1
  assign p2 = section.settings.product_2
  assign p3 = section.settings.product_3
  assign p4 = section.settings.product_4
  assign p5 = section.settings.product_5
  assign p6 = section.settings.product_6
  assign handles = p1 | append: '|' | append: p2 | append: '|' | append: p3 | append: '|' | append: p4 | append: '|' | append: p5 | append: '|' | append: p6 | split: '|' | compact | slice: 0, 6

  assign title    = section.settings.title | default: "The Gift Guide"
  assign desc     = section.settings.description | default: "Discover Joy: Your Ultimate Holiday Gift Destination."
  assign cta_text = section.settings.cta_text | default: "SHOP NOW"
  assign cta_url  = section.settings.cta_url | default: '#'

  assign btn_positions = section.settings.button_positions | default: "top-right,top-right,top-right,top-right,top-right,top-right" | split: ','
-%}

<section class="gift-guide-section">
  <div class="gift-guide-header">
    <h2>{{ title }}</h2>
    <p>{{ desc }}</p>
    <a href="{{ cta_url }}" class="cta-button">{{ cta_text }}</a>
  </div>

  <div class="product-grid">
    {%- for handle in handles -%}
      {%- assign product = all_products[handle] -%}
      {%- if product -%}
        {%- assign btn_pos = btn_positions[forloop.index0] | default: 'top-right' -%}
        <div class="product-card">
          <div class="img-wrap">
            <img src="{{ product.featured_image | img_url: '600x600' }}"
                 alt="{{ product.title }}" loading="lazy">
            <button class="quick-btn {{ btn_pos }}" 
                    data-id="{{ product.id }}" 
                    data-handle="{{ product.handle }}"
                    data-title="{{ product.title | escape }}"
                    data-price="{{ product.price | money_without_currency }}"
                    data-image="{{ product.featured_image | img_url: '400x400' }}">+</button>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<!-- Enhanced Modal with Better Color & Size Selection -->
<div id="quick-modal" class="modal">
  <div class="modal-overlay"></div>
  <div class="modal-content">
    <button class="modal-close">&times;</button>
    <div id="modal-inner"></div>
  </div>
</div>

<style>
.gift-guide-section{max-width:1200px;margin:0 auto;padding:40px 20px;font-family:Helvetica,Arial,sans-serif;}
.gift-guide-header{text-align:center;margin-bottom:30px;}
.gift-guide-header h2{font-size:2.5rem;margin-bottom:15px;color:#333;}
.gift-guide-header p{font-size:1.1rem;color:#666;margin-bottom:25px;}
.cta-button{display:inline-block;padding:14px 32px;background:#000;color:#fff;text-decoration:none;border-radius:4px;font-weight:600;text-transform:uppercase;transition:background 0.3s ease;}
.cta-button:hover{background:#333;}

.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px;}
.product-card{position:relative;overflow:hidden;}
.img-wrap{position:relative;overflow:hidden;border-radius:8px;}
.img-wrap img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;}

/* Button positioning classes */
.quick-btn{position:absolute;width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,0.95);color:#333;border:none;font-size:18px;cursor:pointer;line-height:1;font-weight:bold;box-shadow:0 2px 12px rgba(0,0,0,0.25);transition:all 0.3s ease;z-index:5;}
.quick-btn:hover{background:#fff;transform:scale(1.1);box-shadow:0 4px 16px rgba(0,0,0,0.3);}

.quick-btn.top-left{top:15px;left:15px;}
.quick-btn.top-center{top:15px;left:50%;transform:translateX(-50%);}
.quick-btn.top-right{top:15px;right:15px;}
.quick-btn.center-left{top:50%;left:15px;transform:translateY(-50%);}
.quick-btn.center{top:50%;left:50%;transform:translate(-50%,-50%);}
.quick-btn.center-right{top:50%;right:15px;transform:translateY(-50%);}
.quick-btn.bottom-left{bottom:15px;left:15px;}
.quick-btn.bottom-center{bottom:15px;left:50%;transform:translateX(-50%);}
.quick-btn.bottom-right{bottom:15px;right:15px;}

/* Enhanced Modal Design */
.modal{display:none;position:fixed;inset:0;z-index:10000;}
.modal-overlay{position:absolute;inset:0;background:rgba(0,0,0,0.7);backdrop-filter:blur(2px);}
.modal-content{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#fff;border-radius:0;width:90%;max-width:380px;max-height:90vh;overflow-y:auto;box-shadow:0 10px 30px rgba(0,0,0,0.3);}
.modal-close{position:absolute;top:12px;right:15px;background:none;border:none;font-size:20px;color:#999;cursor:pointer;z-index:1;width:25px;height:25px;display:flex;align-items:center;justify-content:center;font-weight:300;}
.modal-close:hover{color:#333;}

/* Modal Content Styles */
.modal-product{padding:0;}
.modal-product-image{width:100%;height:150px;object-fit:cover;display:block;margin-bottom:0;}
.modal-content-inner{padding:20px;}
.modal-product-title{font-size:1rem;font-weight:500;color:#333;margin:0 0 5px 0;line-height:1.3;}
.modal-product-price{font-size:1rem;font-weight:400;color:#333;margin:0 0 8px 0;}
.modal-product-description{font-size:0.85rem;color:#666;line-height:1.4;margin:0 0 20px 0;}

/* Enhanced Form Styles */
.modal-form-group{margin-bottom:20px;}
.modal-form-label{display:block;font-weight:500;color:#333;margin-bottom:8px;font-size:0.9rem;}

/* Enhanced Color Options - Exact Component Match */
.modal-color-options{display:grid;grid-template-columns:1fr 1fr;gap:0;margin-bottom:0;border:1px solid #ccc;border-radius:0;background:#fff;}
.modal-color-option{position:relative;}
.modal-color-btn{width:100%;padding:12px 16px;border:none;background:#f5f5f5;color:#333;font-size:0.875rem;font-weight:400;cursor:pointer;transition:all 0.1s ease;text-align:center;border-right:1px solid #ccc;min-height:40px;display:flex;align-items:center;justify-content:center;position:relative;}
.modal-color-btn:last-child{border-right:none;}
.modal-color-btn:hover{opacity:0.8;}
.modal-color-btn.selected{background:#000;color:#fff;}

/* Color-specific styling */
.modal-color-btn[data-color="Red"].selected{background:#000;color:#fff;}
.modal-color-btn[data-color="Blue"].selected{background:#000;color:#fff;}
.modal-color-btn[data-color="Grey"].selected,
.modal-color-btn[data-color="Gray"].selected{background:#000;color:#fff;}
.modal-color-btn[data-color="White"].selected{background:#000;color:#fff;}
.modal-color-btn[data-color="Black"].selected{background:#000;color:#fff;}

/* Size Selection Styles - Exact Component Match */
.modal-size-wrapper{position:relative;}
.modal-size-select{width:100%;padding:12px 16px;border:1px solid #ccc;border-radius:0;font-size:0.875rem;color:#333;background:#ffffff;cursor:pointer;transition:border-color 0.1s ease;appearance:none;background-image:url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%23666' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");background-position:right 12px center;background-repeat:no-repeat;background-size:16px;padding-right:40px;min-height:40px;}
.modal-size-select:focus{outline:none;border-color:#999;}
.modal-size-select option{padding:8px;color:#333;}

/* Size Button Alternative - Component Style */
.modal-size-button-style{border:1px solid #ccc;background:#ffffff;margin-bottom:0;}
.modal-size-btn{width:100%;padding:12px 16px;border:none;background:#f5f5f5;color:#333;font-size:0.875rem;cursor:pointer;transition:all 0.1s ease;text-align:center;font-weight:400;min-height:40px;display:flex;align-items:center;justify-content:center;border-bottom:1px solid #ccc;}
.modal-size-btn:last-child{border-bottom:none;}
.modal-size-btn:hover{opacity:0.8;}
.modal-size-btn.selected{background:#000;color:#fff;}
.modal-size-btn:disabled{background:#f0f0f0;color:#999;cursor:not-allowed;}

/* Add to Cart Button */
.modal-add-to-cart{width:100%;padding:15px;background:#000;color:#fff;border:none;font-size:0.9rem;font-weight:500;text-transform:uppercase;border-radius:0;cursor:pointer;transition:background 0.3s ease;margin-top:20px;display:flex;align-items:center;justify-content:center;gap:8px;letter-spacing:0.5px;}
.modal-add-to-cart:hover{background:#333;}
.modal-add-to-cart:disabled{background:#ccc;cursor:not-allowed;}

/* Out of Stock Messaging */
.modal-stock-message{padding:8px 12px;background:#f8f8f8;border:1px solid #ddd;color:#666;font-size:0.8rem;text-align:center;margin-top:10px;}
.modal-stock-message.in-stock{background:#f0f8f0;color:#2d5a27;border-color:#c3e6c3;}
.modal-stock-message.out-of-stock{background:#fdf2f2;color:#991b1b;border-color:#fecaca;}

/* Responsive Design */
@media (max-width: 768px) {
  .product-grid{grid-template-columns:repeat(2,1fr);gap:15px;}
  .gift-guide-header h2{font-size:2rem;}
  .modal-content{width:95%;max-width:400px;}
  .modal-color-btn{padding:8px 12px;font-size:0.8rem;}
  .modal-size-options{grid-template-columns:repeat(3, 1fr);}
}

@media (max-width: 480px) {
  .product-grid{grid-template-columns:1fr;gap:15px;}
  .quick-btn{width:28px;height:28px;font-size:16px;}
  .quick-btn.top-left,.quick-btn.center-left,.quick-btn.bottom-left{left:10px;}
  .quick-btn.top-right,.quick-btn.center-right,.quick-btn.bottom-right{right:10px;}
  .quick-btn.top-left,.quick-btn.top-center,.quick-btn.top-right{top:10px;}
  .quick-btn.bottom-left,.quick-btn.bottom-center,.quick-btn.bottom-right{bottom:10px;}
  .modal-size-options{grid-template-columns:repeat(2, 1fr);}
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const modal = document.getElementById('quick-modal');
  const modalOverlay = modal.querySelector('.modal-overlay');
  const inner = document.getElementById('modal-inner');
  const close = modal.querySelector('.modal-close');
  let currentProduct = null;

  console.log('Enhanced Gift Guide Modal Script Loaded');

  // Open modal
  document.addEventListener('click', function(e) {
    if (!e.target.classList.contains('quick-btn')) return;
    e.preventDefault();
    e.stopPropagation();

    const productId = e.target.dataset.id;
    const productHandle = e.target.dataset.handle;
    const productTitle = e.target.dataset.title;
    const productPrice = e.target.dataset.price;
    const productImage = e.target.dataset.image;
    
    // Show loading
    inner.innerHTML = '<div style="padding:40px;text-align:center;"><div style="display:inline-block;width:30px;height:30px;border:3px solid #f3f3f3;border-top:3px solid #333;border-radius:50%;animation:spin 1s linear infinite;"></div><p style="margin-top:15px;color:#666;">Loading product...</p></div>';
    modal.style.display = 'block';
    document.body.style.overflow = 'hidden';

    // Fetch product data
    if (productId) {
      fetch(`/products/${productId}.js`)
        .then(r => {
          if (!r.ok) throw new Error('Product not found');
          return r.json();
        })
        .then(p => {
          currentProduct = p;
          renderModal(p);
        })
        .catch(err => {
          if (productHandle) {
            fetchByHandle(productHandle);
          } else {
            showError();
          }
        });
    } else if (productHandle) {
      fetchByHandle(productHandle);
    } else {
      showError();
    }
  });

  function fetchByHandle(handle) {
    fetch(`/products/${handle}.js`)
      .then(r => {
        if (!r.ok) throw new Error('Handle fetch failed');
        return r.json();
      })
      .then(p => {
        currentProduct = p;
        renderModal(p);
      })
      .catch(err => {
        showError();
      });
  }

  function showError() {
    inner.innerHTML = `
      <div style="padding:40px;text-align:center;">
        <p style="color:#999;margin-bottom:20px;">Sorry, product details could not be loaded.</p>
        <button onclick="document.getElementById('quick-modal').style.display='none'; document.body.style.overflow='';" 
                style="padding:10px 20px;background:#000;color:#fff;border:none;border-radius:4px;cursor:pointer;">
          Close
        </button>
      </div>
    `;
  }

  function closeModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
    currentProduct = null;
  }

  close.addEventListener('click', closeModal);
  modalOverlay.addEventListener('click', closeModal);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.style.display === 'block') {
      closeModal();
    }
  });

  function renderModal(product) {
    if (!product) {
      inner.innerHTML = '<div style="padding:40px;text-align:center;color:#999;">Product details unavailable.</div>';
      return;
    }

    // Handle price formatting
    let price = '0.00';
    if (product.price_min) {
      price = (product.price_min / 100).toFixed(2);
    } else if (product.price) {
      price = typeof product.price === 'string' ? product.price.replace(/[^\d.]/g, '') : (product.price / 100).toFixed(2);
    }

    const imageUrl = product.images && product.images[0] ? product.images[0] : product.featured_image;
    const variants = product.variants || [{ id: product.id, title: 'Default', available: true }];
    
    // Extract unique options
    const colors = [...new Set(variants.map(v => v.option1).filter(Boolean))];
    const sizes = [...new Set(variants.map(v => v.option2 || v.option3).filter(Boolean))];
    
    // Check if we should use button or dropdown for sizes
    const useSizeButtons = sizes.length <= 6 && sizes.every(size => size.length <= 3);

    inner.innerHTML = `
      <div class="modal-product">
        ${imageUrl ? `<img src="${imageUrl}" alt="${product.title}" class="modal-product-image">` : ''}
        <div class="modal-content-inner">
          <h3 class="modal-product-title">${product.title}</h3>
          <div class="modal-product-price">€${price}</div>
          ${product.description ? `<div class="modal-product-description">${product.description.substring(0, 120)}${product.description.length > 120 ? '...' : ''}</div>` : ''}
          
          <form id="add-to-cart-form" action="/cart/add" method="post">
            ${colors.length > 1 ? `
              <div class="modal-form-group">
                <label class="modal-form-label">Color</label>
                <div class="modal-color-options" id="color-options">
                  ${colors.map((color, index) => `
                    <div class="modal-color-option">
                      <button type="button" class="modal-color-btn ${index === 0 ? 'selected' : ''}" data-color="${color}">
                        ${color}
                      </button>
                    </div>
                  `).join('')}
                </div>
              </div>
            ` : ''}
            
            ${sizes.length > 1 ? `
              <div class="modal-form-group">
                <label class="modal-form-label">Size</label>
                ${useSizeButtons ? `
                  <div class="modal-size-button-style" id="size-button-container">
                    ${sizes.map((size, index) => `
                      <button type="button" class="modal-size-btn ${index === 0 ? 'selected' : ''}" data-size="${size}">
                        ${size}
                      </button>
                    `).join('')}
                  </div>
                ` : `
                  <div class="modal-size-wrapper">
                    <select class="modal-size-select" id="size-select" required>
                      <option value="">Choose your size</option>
                      ${sizes.map(size => `<option value="${size}">${size}</option>`).join('')}
                    </select>
                  </div>
                `}
              </div>
            ` : ''}
            
            <input type="hidden" name="id" id="variant-id" value="${variants[0].id}" required>
            
            <div id="stock-message" class="modal-stock-message" style="display:none;"></div>
            
            <button type="submit" class="modal-add-to-cart" id="add-to-cart-btn">
              <span>ADD TO CART</span>
              <span>→</span>
            </button>
          </form>
        </div>
      </div>
    `;

    setupFormInteractions(variants);
  }

  function setupFormInteractions(variants, useSizeButtons) {
    const colorBtns = document.querySelectorAll('.modal-color-btn');
    const sizeBtns = document.querySelectorAll('.modal-size-btn');
    const sizeSelect = document.getElementById('size-select');
    const variantInput = document.getElementById('variant-id');
    const stockMessage = document.getElementById('stock-message');
    const addBtn = document.getElementById('add-to-cart-btn');
    const form = document.getElementById('add-to-cart-form');

    let selectedColor = colorBtns.length > 0 ? colorBtns[0].dataset.color : null;
    let selectedSize = sizeBtns.length > 0 ? sizeBtns[0].dataset.size : null;

    // Color selection
    colorBtns.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        colorBtns.forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        selectedColor = btn.dataset.color;
        updateVariant();
      });
    });

    // Size button selection
    sizeBtns.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        sizeBtns.forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        selectedSize = btn.dataset.size;
        updateVariant();
      });
    });

    // Size dropdown selection
    if (sizeSelect) {
      sizeSelect.addEventListener('change', function() {
        selectedSize = sizeSelect.value;
        updateVariant();
      });
    }

    function updateVariant() {
      if (!variants || !Array.isArray(variants)) return;

      let variant = variants.find(v => {
        if (selectedColor && selectedSize) {
          return (v.option1 === selectedColor || v.option2 === selectedColor) && 
                 (v.option2 === selectedSize || v.option3 === selectedSize);
        } else if (selectedColor) {
          return v.option1 === selectedColor || v.option2 === selectedColor;
        } else if (selectedSize) {
          return v.option2 === selectedSize || v.option3 === selectedSize;
        }
        return true;
      });

      if (!variant) {
        variant = variants[0];
      }

      if (variant && variantInput) {
        variantInput.value = variant.id;
        
        // Update stock message and button state
        updateStockDisplay(variant);
      }
    }

    function updateStockDisplay(variant) {
      if (!stockMessage || !addBtn) return;

      if (variant.available) {
        stockMessage.textContent = 'In stock';
        stockMessage.className = 'modal-stock-message in-stock';
        stockMessage.style.display = 'block';
        addBtn.disabled = false;
        addBtn.innerHTML = '<span>ADD TO CART</span><span>→</span>';
      } else {
        stockMessage.textContent = 'Out of stock';
        stockMessage.className = 'modal-stock-message out-of-stock';
        stockMessage.style.display = 'block';
        addBtn.disabled = true;
        addBtn.innerHTML = '<span>OUT OF STOCK</span>';
      }
    }

    // Initialize variant
    updateVariant();

    // Form submission
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData(form);
        
        if (addBtn) {
          addBtn.innerHTML = '<span>ADDING...</span>';
          addBtn.disabled = true;
        }

        fetch('/cart/add.js', {
          method: 'POST',
          body: formData
        })
        .then(response => response.json())
        .then(data => {
          if (addBtn) {
            addBtn.innerHTML = '<span>ADDED!</span> <span>✓</span>';
          }
          setTimeout(() => {
            closeModal();
          }, 1000);
        })
        .catch(error => {
          console.error('Error:', error);
          if (addBtn) {
            addBtn.innerHTML = '<span>ADD TO CART</span> <span>→</span>';
            addBtn.disabled = false;
          }
          alert('Sorry, there was an error adding the product to cart.');
        });
      });
    }
  }

  // Add spinning animation
  const style = document.createElement('style');
  style.textContent = '@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }';
  document.head.appendChild(style);
});
</script>

{% schema %}
{
  "name": "Gift Guide",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL"
    },
    {
      "type": "text",
      "id": "button_positions",
      "label": "Button Positions",
      "info": "Comma-separated positions for each product button: top-left, top-center, top-right, center-left, center, center-right, bottom-left, bottom-center, bottom-right",
      "default": "top-right,top-right,top-right,top-right,top-right,top-right"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    },
    {
      "type": "product",
      "id": "product_5",
      "label": "Product 5"
    },
    {
      "type": "product",
      "id": "product_6",
      "label": "Product 6"
    }
  ],
  "presets": [
    { "name": "Gift Guide" }
  ]
}
{% endschema %}