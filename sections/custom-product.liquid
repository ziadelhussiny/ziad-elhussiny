{%- liquid
  assign p1 = section.settings.product_1
  assign p2 = section.settings.product_2
  assign p3 = section.settings.product_3
  assign p4 = section.settings.product_4
  assign p5 = section.settings.product_5
  assign p6 = section.settings.product_6
  assign handles = p1 | append: '|' | append: p2 | append: '|' | append: p3 | append: '|' | append: p4 | append: '|' | append: p5 | append: '|' | append: p6 | split: '|' | compact | slice: 0, 6

  assign title    = section.settings.title | default: "The Gift Guide"
  assign desc     = section.settings.description | default: "Discover Joy: Your Ultimate Holiday Gift Destination."
  assign cta_text = section.settings.cta_text | default: "SHOP NOW"
  assign cta_url  = section.settings.cta_url | default: '#'

  assign btn_positions = section.settings.button_positions | default: "top-right,top-right,top-right,top-right,top-right,top-right" | split: ','
-%}

<section class="gift-guide-section">
  <div class="gift-guide-header">
    <h2>{{ title }}</h2>
    <p>{{ desc }}</p>
    <a href="{{ cta_url }}" class="cta-button">{{ cta_text }}</a>
  </div>

  <div class="product-grid">
    {%- for handle in handles -%}
      {%- assign product = all_products[handle] -%}
      {%- if product -%}
        {%- assign btn_pos = btn_positions[forloop.index0] | default: 'top-right' -%}
        <div class="product-card">
          <div class="img-wrap">
            <img src="{{ product.featured_image | img_url: '600x600' }}"
                 alt="{{ product.title }}" loading="lazy">
            <button class="quick-btn {{ btn_pos }}" 
                    data-id="{{ product.id }}" 
                    data-handle="{{ product.handle }}"
                    data-title="{{ product.title | escape }}"
                    data-price="{{ product.price | money_without_currency }}"
                    data-image="{{ product.featured_image | img_url: '400x400' }}">+</button>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<!-- Enhanced Modal with Better Color & Size Selection -->
<div id="quick-modal" class="modal">
  <div class="modal-overlay"></div>
  <div class="modal-content">
    <button class="modal-close">&times;</button>
    <div id="modal-inner"></div>
  </div>
</div>

<style>
.gift-guide-section{max-width:1200px;margin:0 auto;padding:40px 20px;font-family:Helvetica,Arial,sans-serif;}
.gift-guide-header{text-align:center;margin-bottom:30px;}
.gift-guide-header h2{font-size:2.5rem;margin-bottom:15px;color:#333;}
.gift-guide-header p{font-size:1.1rem;color:#666;margin-bottom:25px;}
.cta-button{display:inline-block;padding:14px 32px;background:#000;color:#fff;text-decoration:none;border-radius:4px;font-weight:600;text-transform:uppercase;transition:background 0.3s ease;}
.cta-button:hover{background:#333;}

.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px;}
.product-card{position:relative;overflow:hidden;}
.img-wrap{position:relative;overflow:hidden;border-radius:8px;}
.img-wrap img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;}

/* Button positioning classes */
.quick-btn{position:absolute;width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,0.95);color:#333;border:none;font-size:18px;cursor:pointer;line-height:1;font-weight:bold;box-shadow:0 2px 12px rgba(0,0,0,0.25);transition:all 0.3s ease;z-index:5;}
.quick-btn:hover{background:#fff;transform:scale(1.1);box-shadow:0 4px 16px rgba(0,0,0,0.3);}

.quick-btn.top-left{top:15px;left:15px;}
.quick-btn.top-center{top:15px;left:50%;transform:translateX(-50%);}
.quick-btn.top-right{top:15px;right:15px;}
.quick-btn.center-left{top:50%;left:15px;transform:translateY(-50%);}
.quick-btn.center{top:50%;left:50%;transform:translate(-50%,-50%);}
.quick-btn.center-right{top:50%;right:15px;transform:translateY(-50%);}
.quick-btn.bottom-left{bottom:15px;left:15px;}
.quick-btn.bottom-center{bottom:15px;left:50%;transform:translateX(-50%);}
.quick-btn.bottom-right{bottom:15px;right:15px;}

/* Enhanced Modal Design - Matching the Image Layout */
.modal{display:none;position:fixed;inset:0;z-index:10000;}
.modal-overlay{position:absolute;inset:0;background:rgba(0,0,0,0.7);backdrop-filter:blur(2px);}
.modal-content{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#fff;border-radius:8px;width:90%;max-width:600px;max-height:90vh;overflow-y:auto;box-shadow:0 10px 30px rgba(0,0,0,0.3);}
.modal-close{position:absolute;top:15px;right:15px;background:none;border:none;font-size:24px;color:#999;cursor:pointer;z-index:1;width:30px;height:30px;display:flex;align-items:center;justify-content:center;font-weight:300;}
.modal-close:hover{color:#333;}

/* Modal Content Styles - Two Column Layout */
.modal-product{display:flex;padding:0;min-height:400px;}
.modal-product-image{width:50%;height:400px;object-fit:cover;display:block;margin:0;border:2px solid #e3f2fd;border-radius:8px 0 0 8px;}
.modal-content-inner{width:50%;padding:30px;display:flex;flex-direction:column;justify-content:space-between;}
.modal-product-info{margin-bottom:20px;}
.modal-product-title{font-size:1.5rem;font-weight:600;color:#333;margin:0 0 10px 0;line-height:1.3;}
.modal-product-price{font-size:1.8rem;font-weight:700;color:#333;margin:0 0 15px 0;}
.modal-product-description{font-size:0.95rem;color:#666;line-height:1.5;margin:0 0 25px 0;}

/* Enhanced Form Styles */
.modal-form-group{margin-bottom:25px;}
.modal-form-label{display:block;font-weight:600;color:#333;margin-bottom:12px;font-size:1rem;}

/* Enhanced Color Options - Component 208-211 Style */
.modal-color-options{display:flex;flex-direction:column;gap:8px;margin-bottom:0;}
.modal-color-option{position:relative;width:100%;}
.modal-color-btn{width:100%;padding:0;border:1px solid #d1d5db;border-radius:6px;background:#fff;cursor:pointer;transition:all 0.15s ease;min-height:48px;display:flex;position:relative;overflow:hidden;}
.modal-color-btn:hover{border-color:#9ca3af;}
.modal-color-btn.selected{border-color:#111827;}
.modal-color-btn:focus{outline:2px solid #3b82f6;outline-offset:-2px;}

/* Two-part button structure */
.modal-color-btn-left{flex:1;padding:14px 18px;background:#f9fafb;color:#374151;font-size:0.9rem;font-weight:500;display:flex;align-items:center;justify-content:center;position:relative;border-right:1px solid #d1d5db;transition:all 0.15s ease;}
.modal-color-btn-right{flex:1;padding:14px 18px;background:#ffffff;color:#374151;font-size:0.9rem;font-weight:500;display:flex;align-items:center;justify-content:center;transition:all 0.15s ease;}

/* Selected state styling */
.modal-color-btn.selected .modal-color-btn-left{background:#111827;color:#ffffff;font-weight:600;}
.modal-color-btn.selected .modal-color-btn-right{background:#111827;color:#ffffff;font-weight:600;}

/* Hover effects */
.modal-color-btn:hover .modal-color-btn-left{background:#f3f4f6;}
.modal-color-btn:hover .modal-color-btn-right{background:#f9fafb;}

/* Left-edge color indicators - Component 208-211 style */
.modal-color-btn[data-color*="Red"] .modal-color-btn-left:before,
.modal-color-btn[data-color*="red"] .modal-color-btn-left:before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:#dc2626;}
.modal-color-btn[data-color*="Blue"] .modal-color-btn-left:before,
.modal-color-btn[data-color*="blue"] .modal-color-btn-left:before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:#2563eb;}
.modal-color-btn[data-color*="Grey"] .modal-color-btn-left:before,
.modal-color-btn[data-color*="Gray"] .modal-color-btn-left:before,
.modal-color-btn[data-color*="grey"] .modal-color-btn-left:before,
.modal-color-btn[data-color*="gray"] .modal-color-btn-left:before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:#6b7280;}
.modal-color-btn[data-color*="White"] .modal-color-btn-left:before,
.modal-color-btn[data-color*="white"] .modal-color-btn-left:before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:#ffffff;border-right:1px solid #d1d5db;}
.modal-color-btn[data-color*="Black"] .modal-color-btn-left:before,
.modal-color-btn[data-color*="black"] .modal-color-btn-left:before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:#111827;}
.modal-color-btn[data-color*="Green"] .modal-color-btn-left:before,
.modal-color-btn[data-color*="green"] .modal-color-btn-left:before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:#16a34a;}
.modal-color-btn[data-color*="Yellow"] .modal-color-btn-left:before,
.modal-color-btn[data-color*="yellow"] .modal-color-btn-left:before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:#eab308;}
.modal-color-btn[data-color*="Pink"] .modal-color-btn-left:before,
.modal-color-btn[data-color*="pink"] .modal-color-btn-left:before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:#ec4899;}
.modal-color-btn[data-color*="Purple"] .modal-color-btn-left:before,
.modal-color-btn[data-color*="purple"] .modal-color-btn-left:before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:#8b5cf6;}

/* Size Selection Styles - Component 212 & 213 style */
.modal-size-wrapper{position:relative;margin-bottom:0;}
.modal-size-select{width:100%;padding:14px 18px;border:1px solid #d1d5db;border-radius:6px;font-size:0.9rem;color:#374151;background:#ffffff;cursor:pointer;transition:all 0.15s ease;appearance:none;background-image:url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");background-position:right 16px center;background-repeat:no-repeat;background-size:18px;padding-right:50px;min-height:48px;font-weight:500;}
.modal-size-select:hover{border-color:#9ca3af;}
.modal-size-select:focus{outline:none;border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,0.1);}
.modal-size-select option{padding:10px;color:#374151;background:#ffffff;}

/* Size Button Alternative - Component 212 style for smaller sets */
.modal-size-button-style{border:1px solid #d1d5db;background:#ffffff;margin-bottom:0;border-radius:6px;overflow:hidden;}
.modal-size-btn{width:100%;padding:14px 18px;border:none;background:#ffffff;color:#374151;font-size:0.9rem;cursor:pointer;transition:all 0.15s ease;text-align:center;font-weight:500;min-height:48px;display:flex;align-items:center;justify-content:center;border-bottom:1px solid #d1d5db;}
.modal-size-btn:last-child{border-bottom:none;}
.modal-size-btn:hover{background:#f9fafb;}
.modal-size-btn.selected{background:#111827;color:#ffffff;font-weight:600;}
.modal-size-btn:focus{outline:2px solid #3b82f6;outline-offset:-2px;}
.modal-size-btn:disabled{background:#f3f4f6;color:#9ca3af;cursor:not-allowed;}

/* Add to Cart Button - Matching the Image */
.modal-add-to-cart{width:100%;padding:18px;background:#000;color:#fff;border:none;font-size:1rem;font-weight:600;text-transform:uppercase;border-radius:6px;cursor:pointer;transition:background 0.3s ease;margin-top:30px;display:flex;align-items:center;justify-content:center;gap:10px;letter-spacing:0.5px;min-height:54px;}
.modal-add-to-cart:hover{background:#333;}
.modal-add-to-cart:disabled{background:#ccc;cursor:not-allowed;}

/* Out of Stock Messaging */
.modal-stock-message{padding:10px 15px;background:#f8f8f8;border:1px solid #ddd;color:#666;font-size:0.85rem;text-align:center;margin-top:15px;border-radius:4px;}
.modal-stock-message.in-stock{background:#f0f8f0;color:#2d5a27;border-color:#c3e6c3;}
.modal-stock-message.out-of-stock{background:#fdf2f2;color:#991b1b;border-color:#fecaca;}

/* Responsive Design */
@media (max-width: 768px) {
  .modal-content{max-width:500px;}
  .modal-product{flex-direction:column;}
  .modal-product-image{width:100%;height:250px;border-radius:8px 8px 0 0;}
  .modal-content-inner{width:100%;padding:25px;}
  .modal-product-title{font-size:1.3rem;}
  .modal-product-price{font-size:1.5rem;}
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const modal = document.getElementById('quick-modal');
  const modalOverlay = modal.querySelector('.modal-overlay');
  const inner = document.getElementById('modal-inner');
  const close = modal.querySelector('.modal-close');
  let currentProduct = null;

  console.log('Enhanced Gift Guide Modal Script Loaded');

  // Open modal
  document.addEventListener('click', function(e) {
    if (!e.target.classList.contains('quick-btn')) return;
    e.preventDefault();
    e.stopPropagation();

    const productId = e.target.dataset.id;
    const productHandle = e.target.dataset.handle;
    const productTitle = e.target.dataset.title;
    const productPrice = e.target.dataset.price;
    const productImage = e.target.dataset.image;
    
    console.log('Button clicked with data:', { productId, productHandle, productTitle, productPrice, productImage });
    
    // Show loading
    inner.innerHTML = '<div style="padding:40px;text-align:center;"><div style="display:inline-block;width:30px;height:30px;border:3px solid #f3f3f3;border-top:3px solid #333;border-radius:50%;animation:spin 1s linear infinite;"></div><p style="margin-top:15px;color:#666;">Loading product...</p></div>';
    modal.style.display = 'block';
    document.body.style.overflow = 'hidden';

    // Always try to fetch fresh product data for accurate variants
    if (productHandle) {
      console.log('Fetching by handle:', productHandle);
      fetchByHandle(productHandle);
    } else if (productId) {
      console.log('Fetching by ID:', productId);
      fetch(`/products/${productId}.js`)
        .then(r => {
          console.log('API Response status:', r.status);
          if (!r.ok) throw new Error(`HTTP ${r.status}: Product not found`);
          return r.json();
        })
        .then(p => {
          console.log('Product data received:', p);
          currentProduct = p;
          renderModal(p);
        })
        .catch(err => {
          console.error('Fetch by ID failed:', err);
          showError(err.message);
        });
    } else {
      showError('No product ID or handle provided');
    }
  });

  function fetchByHandle(handle) {
    fetch(`/products/${handle}.js`)
      .then(r => {
        console.log('Handle fetch response status:', r.status);
        if (!r.ok) throw new Error(`HTTP ${r.status}: Handle fetch failed`);
        return r.json();
      })
      .then(p => {
        console.log('Product data from handle:', p);
        currentProduct = p;
        renderModal(p);
      })
      .catch(err => {
        console.error('Handle fetch failed:', err);
        showError(err.message);
      });
  }

  function showError(errorMsg = 'Unknown error') {
    console.error('Showing error:', errorMsg);
    inner.innerHTML = `
      <div style="padding:40px;text-align:center;">
        <p style="color:#999;margin-bottom:15px;">Sorry, product details could not be loaded.</p>
        <p style="color:#666;margin-bottom:20px;font-size:0.9em;">Error: ${errorMsg}</p>
        <button onclick="document.getElementById('quick-modal').style.display='none'; document.body.style.overflow='';" 
                style="padding:10px 20px;background:#000;color:#fff;border:none;border-radius:4px;cursor:pointer;">
          Close
        </button>
      </div>
    `;
  }

  function closeModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
    currentProduct = null;
  }

  close.addEventListener('click', closeModal);
  modalOverlay.addEventListener('click', closeModal);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.style.display === 'block') {
      closeModal();
    }
  });

  function renderModal(product) {
    if (!product) {
      inner.innerHTML = '<div style="padding:40px;text-align:center;color:#999;">Product details unavailable.</div>';
      return;
    }

    // Debug logging
    console.log('Product data received:', product);
    console.log('Product variants:', product.variants);
    console.log('Product options:', product.options);
    console.log('Product options type:', typeof product.options);
    console.log('Product options is array:', Array.isArray(product.options));

    // Handle price formatting
    let price = '0.00';
    if (product.price_min) {
      price = (product.price_min / 100).toFixed(2);
    } else if (product.price) {
      price = typeof product.price === 'string' ? product.price.replace(/[^\d.]/g, '') : (product.price / 100).toFixed(2);
    }

    const imageUrl = product.images && product.images[0] ? product.images[0] : product.featured_image;
    
    // Ensure variants is always an array
    let variants = [];
    if (product.variants && Array.isArray(product.variants)) {
      variants = product.variants;
    } else if (product.variants && typeof product.variants === 'object') {
      // If variants is an object, try to convert it
      variants = Object.values(product.variants);
    } else {
      // Fallback to default variant
      variants = [{ id: product.id, title: 'Default', available: true }];
    }
    
    // Ensure optionNames is always an array
    let optionNames = [];
    if (product.options && Array.isArray(product.options)) {
      optionNames = product.options;
    } else if (product.options && typeof product.options === 'object') {
      // If options is an object, try to convert it
      optionNames = Object.values(product.options);
    } else {
      optionNames = [];
    }
    
    console.log('Processed variants:', variants);
    console.log('Processed optionNames:', optionNames);
    
              // Enhanced variant detection logic
     let colorOptions = [];
     let sizeOptions = [];
     
     try {
       // Ensure optionNames is an array and has content
       if (variants.length > 1 && Array.isArray(optionNames) && optionNames.length > 0) {
         // Extract unique values for each option
         const option1Values = [...new Set(variants.map(v => v.option1).filter(Boolean))];
         const option2Values = [...new Set(variants.map(v => v.option2).filter(Boolean))];
         const option3Values = [...new Set(variants.map(v => v.option3).filter(Boolean))];
         
         // Common color and size keywords
         const colorKeywords = ['color', 'colour', 'red', 'blue', 'green', 'black', 'white', 'grey', 'gray', 'yellow', 'pink', 'purple', 'brown', 'orange', 'navy', 'beige', 'tan'];
         const sizeKeywords = ['size', 'xs', 's', 'm', 'l', 'xl', 'xxl', 'small', 'medium', 'large', 'extra', '2xl', '3xl', '4xl', '5xl'];
         
         // Check option names first - with proper null checks
         const option1Name = (optionNames[0] && typeof optionNames[0] === 'string') ? optionNames[0].toLowerCase() : '';
         const option2Name = (optionNames[1] && typeof optionNames[1] === 'string') ? optionNames[1].toLowerCase() : '';
         const option3Name = (optionNames[2] && typeof optionNames[2] === 'string') ? optionNames[2].toLowerCase() : '';
         
         console.log('Option names processed:', { option1Name, option2Name, option3Name });
         
         // Determine which option is color vs size based on names
         if (colorKeywords.some(keyword => option1Name.includes(keyword))) {
           colorOptions = option1Values;
           if (sizeKeywords.some(keyword => option2Name.includes(keyword))) {
             sizeOptions = option2Values;
           } else if (option3Values.length > 0 && sizeKeywords.some(keyword => option3Name.includes(keyword))) {
             sizeOptions = option3Values;
           } else {
             sizeOptions = option2Values.length > 0 ? option2Values : option3Values;
           }
         } else if (sizeKeywords.some(keyword => option1Name.includes(keyword))) {
           sizeOptions = option1Values;
           if (colorKeywords.some(keyword => option2Name.includes(keyword))) {
             colorOptions = option2Values;
           } else if (option3Values.length > 0 && colorKeywords.some(keyword => option3Name.includes(keyword))) {
             colorOptions = option3Values;
           } else {
             colorOptions = option2Values.length > 0 ? option2Values : option3Values;
           }
         } else {
           // Fallback: analyze actual values to determine type
           const isOption1Color = option1Values.some(val => 
             colorKeywords.some(keyword => val.toLowerCase().includes(keyword))
           );
           const isOption1Size = option1Values.some(val => 
             sizeKeywords.some(keyword => val.toLowerCase().includes(keyword)) || 
             /^(xs|s|m|l|xl|xxl|2xl|3xl|4xl|5xl|\d+)$/i.test(val)
           );
           
           if (isOption1Color && !isOption1Size) {
             colorOptions = option1Values;
             sizeOptions = option2Values.length > 0 ? option2Values : option3Values;
           } else if (isOption1Size && !isOption1Color) {
             sizeOptions = option1Values;
             colorOptions = option2Values.length > 0 ? option2Values : option3Values;
           } else {
             // Default fallback
             colorOptions = option1Values;
             sizeOptions = option2Values.length > 0 ? option2Values : option3Values;
           }
         }
       }
     } catch (error) {
       console.error('Error in variant detection:', error);
       // Fallback to empty arrays if there's an error
       colorOptions = [];
       sizeOptions = [];
     }

         // Remove duplicates and filter out empty values
     colorOptions = [...new Set(colorOptions)].filter(Boolean);
     sizeOptions = [...new Set(sizeOptions)].filter(Boolean);
     
     console.log('Final color options:', colorOptions);
     console.log('Final size options:', sizeOptions);
     
     // Ensure we have at least one variant
     if (variants.length === 0) {
       variants = [{ id: product.id, title: 'Default', available: true }];
     }
     
     // Determine size display method based on count and length
     const useSizeButtons = sizeOptions.length <= 6 && sizeOptions.every(size => size.length <= 4);

         inner.innerHTML = `
       <div class="modal-product">
         ${imageUrl ? `<img src="${imageUrl}" alt="${product.title}" class="modal-product-image">` : ''}
         <div class="modal-content-inner">
           <div class="modal-product-info">
             <h3 class="modal-product-title">${product.title}</h3>
             <div class="modal-product-price">€${price}</div>
             ${product.description ? `<div class="modal-product-description">${product.description.substring(0, 150)}${product.description.length > 150 ? '...' : ''}</div>` : ''}
           </div>
           
           <form id="add-to-cart-form" action="/cart/add" method="post">
             ${colorOptions.length > 1 ? `
               <div class="modal-form-group">
                 <label class="modal-form-label">Color</label>
                 <div class="modal-color-options" id="color-options">
                   ${colorOptions.map((color, index) => `
                     <div class="modal-color-option">
                       <button type="button" class="modal-color-btn ${index === 0 ? 'selected' : ''}" data-color="${color}">
                         <div class="modal-color-btn-left">${color}</div>
                         <div class="modal-color-btn-right">${colorOptions.length > 1 ? (colorOptions[1] !== color ? colorOptions[1] : colorOptions[2] || 'Color') : 'Color'}</div>
                       </button>
                     </div>
                   `).join('')}
                 </div>
               </div>
             ` : ''}
             
             ${sizeOptions.length > 1 ? `
               <div class="modal-form-group">
                 <label class="modal-form-label">Size</label>
                 ${useSizeButtons ? `
                   <div class="modal-size-button-style" id="size-button-container">
                     ${sizeOptions.map((size, index) => `
                       <button type="button" class="modal-size-btn ${index === 0 ? 'selected' : ''}" data-size="${size}">
                         ${size}
                       </button>
                     `).join('')}
                   </div>
                 ` : `
                   <div class="modal-size-wrapper">
                     <select class="modal-size-select" id="size-select" required>
                       <option value="" disabled ${sizeOptions.length > 0 ? 'selected' : ''}>Choose your size</option>
                       ${sizeOptions.map(size => `<option value="${size}">${size}</option>`).join('')}
                     </select>
                   </div>
                 `}
               </div>
             ` : ''}
             
             <input type="hidden" name="id" id="variant-id" value="${variants[0].id}" required>
             
             <div id="stock-message" class="modal-stock-message" style="display:none;"></div>
             
             <button type="submit" class="modal-add-to-cart" id="add-to-cart-btn">
               <span>ADD TO CART</span>
               <span>→</span>
             </button>
           </form>
         </div>
       </div>
     `;

    setupFormInteractions(variants, colorOptions, sizeOptions, optionNames);
  }

     function setupFormInteractions(variants, colorOptions, sizeOptions, optionNames) {
     try {
       // Ensure all parameters are valid
       if (!Array.isArray(variants)) {
         console.error('setupFormInteractions: variants is not an array');
         return;
       }
       
       if (!Array.isArray(colorOptions)) {
         console.error('setupFormInteractions: colorOptions is not an array');
         colorOptions = [];
       }
       
       if (!Array.isArray(sizeOptions)) {
         console.error('setupFormInteractions: sizeOptions is not an array');
         sizeOptions = [];
       }
       
       if (!Array.isArray(optionNames)) {
         console.error('setupFormInteractions: optionNames is not an array');
         optionNames = [];
       }

       const colorBtns = document.querySelectorAll('.modal-color-btn');
       const sizeBtns = document.querySelectorAll('.modal-size-btn');
       const sizeSelect = document.getElementById('size-select');
       const variantInput = document.getElementById('variant-id');
       const stockMessage = document.getElementById('stock-message');
       const addBtn = document.getElementById('add-to-cart-btn');
       const form = document.getElementById('add-to-cart-form');

       // Common color and size keywords for variant matching
       const colorKeywords = ['color', 'colour', 'red', 'blue', 'green', 'black', 'white', 'grey', 'gray', 'yellow', 'pink', 'purple', 'brown', 'orange', 'navy', 'beige', 'tan'];

       let selectedColor = colorOptions.length > 0 ? colorOptions[0] : null;
       let selectedSize = sizeOptions.length > 0 ? sizeOptions[0] : null;

    // Color selection
    colorBtns.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        colorBtns.forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        selectedColor = btn.dataset.color;
        updateVariant();
      });
    });

    // Size button selection
    sizeBtns.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        sizeBtns.forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        selectedSize = btn.dataset.size;
        updateVariant();
      });
    });

    // Size dropdown selection
    if (sizeSelect) {
      sizeSelect.addEventListener('change', function() {
        selectedSize = sizeSelect.value;
        updateVariant();
      });
    }

         function updateVariant() {
       try {
         if (!variants || !Array.isArray(variants)) return;

         // Enhanced variant matching logic
         let variant = null;
         
         if (optionNames.length === 1) {
           // Single option (either color or size)
           if (colorOptions.length > 0) {
             variant = variants.find(v => v.option1 === selectedColor);
           } else if (sizeOptions.length > 0) {
             variant = variants.find(v => v.option1 === selectedSize);
           }
         } else if (optionNames.length === 2) {
           // Two options (color + size or size + color)
           if (colorOptions.length > 0 && sizeOptions.length > 0) {
             // Determine order based on option names - with proper null checks
             const firstOptionName = (optionNames[0] && typeof optionNames[0] === 'string') ? optionNames[0].toLowerCase() : '';
             const isFirstColor = colorKeywords.some(keyword => firstOptionName.includes(keyword));
             
             if (isFirstColor) {
               variant = variants.find(v => v.option1 === selectedColor && v.option2 === selectedSize);
             } else {
               variant = variants.find(v => v.option1 === selectedSize && v.option2 === selectedColor);
             }
           }
         } else if (optionNames.length === 3) {
           // Three options - find the most specific match
           variant = variants.find(v => {
             const matchesColor = !selectedColor || 
               v.option1 === selectedColor || 
               v.option2 === selectedColor || 
               v.option3 === selectedColor;
               
             const matchesSize = !selectedSize || 
               v.option1 === selectedSize || 
               v.option2 === selectedSize || 
               v.option3 === selectedSize;
               
             return matchesColor && matchesSize;
           });
         }

         // Fallback to first variant if no match found
         if (!variant) {
           variant = variants[0];
         }

         if (variant && variantInput) {
           variantInput.value = variant.id;
           
           // Update stock message and button state
           updateStockDisplay(variant);
         }
       } catch (error) {
         console.error('Error in updateVariant:', error);
         // Fallback to first variant on error
         if (variants && variants.length > 0 && variantInput) {
           variantInput.value = variants[0].id;
           updateStockDisplay(variants[0]);
         }
       }
     }

    function updateStockDisplay(variant) {
      if (!stockMessage || !addBtn) return;

      if (variant.available) {
        stockMessage.textContent = 'In stock';
        stockMessage.className = 'modal-stock-message in-stock';
        stockMessage.style.display = 'block';
        addBtn.disabled = false;
        addBtn.innerHTML = '<span>ADD TO CART</span><span>→</span>';
      } else {
        stockMessage.textContent = 'Out of stock';
        stockMessage.className = 'modal-stock-message out-of-stock';
        stockMessage.style.display = 'block';
        addBtn.disabled = true;
        addBtn.innerHTML = '<span>OUT OF STOCK</span>';
      }
    }

    // Initialize variant
    updateVariant();

    // Form submission
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData(form);
        
        if (addBtn) {
          addBtn.innerHTML = '<span>ADDING...</span>';
          addBtn.disabled = true;
        }

        fetch('/cart/add.js', {
          method: 'POST',
          body: formData
        })
        .then(response => response.json())
        .then(data => {
          if (addBtn) {
            addBtn.innerHTML = '<span>ADDED!</span> <span>✓</span>';
          }
          setTimeout(() => {
            closeModal();
          }, 1000);
        })
        .catch(error => {
          console.error('Error:', error);
          if (addBtn) {
            addBtn.innerHTML = '<span>ADD TO CART</span> <span>→</span>';
            addBtn.disabled = false;
          }
          alert('Sorry, there was an error adding the product to cart.');
        });
      });
    }
  } catch (error) {
    console.error('Error in setupFormInteractions:', error);
  }
}

  // Add spinning animation
  const style = document.createElement('style');
  style.textContent = '@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }';
  document.head.appendChild(style);
});
</script>

