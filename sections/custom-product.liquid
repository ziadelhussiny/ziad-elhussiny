{%- liquid
  assign p1 = section.settings.product_1
  assign p2 = section.settings.product_2
  assign p3 = section.settings.product_3
  assign p4 = section.settings.product_4
  assign p5 = section.settings.product_5
  assign p6 = section.settings.product_6
  assign handles = p1 | append: '|' | append: p2 | append: '|' | append: p3 | append: '|' | append: p4 | append: '|' | append: p5 | append: '|' | append: p6 | split: '|' | compact | slice: 0, 6

  assign title    = section.settings.title | default: "The Gift Guide"
  assign desc     = section.settings.description | default: "Discover Joy: Your Ultimate Holiday Gift Destination."
  assign cta_text = section.settings.cta_text | default: "SHOP NOW"
  assign cta_url  = section.settings.cta_url | default: '#'
-%}

<section class="gift-guide-section">
  <div class="gift-guide-header">
    <h2>{{ title }}</h2>
    <p>{{ desc }}</p>
    <a href="{{ cta_url }}" class="cta-button">{{ cta_text }}</a>
  </div>

  <div class="product-grid">
    {%- for handle in products -%}
      {%- assign product = all_products[handle] -%}
      {%- if product -%}
        <div class="product-card">
          <div class="img-wrap">
            <img src="{{ product.featured_image | img_url: '600x600' }}"
                 alt="{{ product.title }}" loading="lazy">
            <button class="quick-btn" data-id="{{ product.id }}">+</button>
          </div>

          <h3>{{ product.title }}</h3>
          <p class="price">{{ product.price | money }}</p>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<!-- Quick-view modal (injected once) -->
<div id="quick-modal" class="modal">
  <div class="modal-content">
    <span class="close">&times;</span>
    <div id="modal-inner"></div>
  </div>
</div>

<style>
.gift-guide-section{max-width:1200px;margin:0 auto;padding:40px 20px;font-family:Helvetica,Arial,sans-serif;}
.gift-guide-header{text-align:center;margin-bottom:30px;}
.cta-button{display:inline-block;padding:14px 32px;background:#000;color:#fff;text-decoration:none;border-radius:4px;}
.product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:30px;}
.product-card{background:#fff;border:1px solid #eee;border-radius:8px;overflow:hidden;text-align:center;}
.img-wrap{position:relative;}
.img-wrap img{width:100%;aspect-ratio:1/1;object-fit:cover;}
.quick-btn{position:absolute;top:10px;right:10px;width:32px;height:32px;border-radius:50%;background:#000;color:#fff;border:none;font-size:20px;cursor:pointer;line-height:1;}
.quick-btn:hover{background:#333;}
.price{margin:8px 0;font-weight:600;}
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:9999;}
.modal-content{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#fff;padding:30px;border-radius:8px;max-width:400px;width:90%;}
.close{position:absolute;top:10px;right:15px;font-size:28px;cursor:pointer;}
</style>

<script>
(() => {
  const modal   = document.getElementById('quick-modal');
  const inner   = document.getElementById('modal-inner');
  const close   = modal.querySelector('.close');

  /* open modal */
  document.addEventListener('click', e => {
    if (!e.target.classList.contains('quick-btn')) return;

    const id = e.target.dataset.id;
    fetch(`/products/${id}.js`)
      .then(r => r.json())
      .then(p => renderModal(p))
      .catch(console.error);
  });

  /* close modal */
  close.onclick = () => modal.style.display = 'none';
  modal.onclick  = e => { if (e.target === modal) modal.style.display = 'none'; };

  /* render HTML inside modal */
  function renderModal(p) {
    const variants = p.variants.map(v => `<option value="${v.id}">${v.title}</option>`).join('');
    inner.innerHTML = `
      <h3>${p.title}</h3>
      <img src="${p.images[0]}" alt="" style="width:100%;max-width:200px;margin-bottom:15px;">
      <p>${p.price_min | money}</p>
      <form action="/cart/add" method="post">
        <label>Variant:
          <select name="id">${variants}</select>
        </label><br><br>
        <button type="submit" class="cta-button">ADD TO CART</button>
      </form>
    `;
    modal.style.display = 'block';
  }
})();
</script>

{% schema %}
{
  "name": "Gift Guide",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    },
    {
      "type": "product",
      "id": "product_5",
      "label": "Product 5"
    },
    {
      "type": "product",
      "id": "product_6",
      "label": "Product 6"
    }
  ],
  "presets": [
    { "name": "Gift Guide" }
  ]
}
{% endschema %}