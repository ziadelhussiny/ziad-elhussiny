{%- liquid
  assign a=section.settings.product_1|append:'|'
  assign b=a|append:section.settings.product_2|append:'|'
  assign c=b|append:section.settings.product_3|append:'|'
  assign d=c|append:section.settings.product_4|append:'|'
  assign e=d|append:section.settings.product_5|append:'|'
  assign handles=e|append:section.settings.product_6|split:'|'|compact|slice:0,6
  assign title=section.settings.title|default:"The Gift Guide"
  assign desc=section.settings.description|default:"Discover Joy"
  assign cta=section.settings.cta_text|default:"SHOP NOW"
  assign url=section.settings.cta_url|default:"#"
-%}

<section class="gift-guide-section">
  <div class="gift-guide-header">
    <h2>{{title}}</h2><p>{{desc}}</p><a href="{{url}}" class="cta">{{cta}}</a>
  </div>
  <div class="product-grid">
    {%- for h in handles -%}{%- assign p=all_products[h] -%}
    {%- if p -%}
    <div class="product-card">
      <img src="{{p.featured_image|img_url:'600x600'}}" alt="{{p.title}}" loading="lazy">
      <button class="quick-btn" data-id="{{p.id}}" data-h="{{p.handle}}" data-t="{{p.title|escape}}" data-p="{{p.price|money_without_currency}}" data-i="{{p.featured_image|img_url:'400x400'}}">+</button>
    </div>
    {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<!-- Modal -->
<div id="modal" class="modal"><div class="overlay"></div><div class="box"><button class="close">×</button><img id="img" alt=""><div class="body"><h3 id="title"></h3><div id="price"></div><form id="form" action="/cart/add" method="post"><input type="hidden" name="id" id="vid"><button type="submit" class="btn">ADD TO CART</button></form></div></div></div>

<style>
*{box-sizing:border-box}
.gift-guide-section{max-width:1200px;margin:0 auto;padding:40px 20px;font-family:Inter}
.gift-guide-header{text-align:center;margin-bottom:30px}
.gift-guide-header h2{font-size:2.5rem;margin:0 0 15px;color:#333}
.gift-guide-header p{font-size:1.1rem;color:#666;margin-bottom:15px}
.cta{display:inline-block;padding:14px 32px;background:#000;color:#fff;border-radius:4px;font-weight:600;text-transform:uppercase;text-decoration:none}
.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.product-card{position:relative;border-radius:8px;overflow:hidden}
img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block}
.quick-btn{position:absolute;top:15px;right:15px;width:32px;height:32px;border-radius:50%;background:#fff;color:#000;border:none;font-size:18px;cursor:pointer;box-shadow:0 2px 12px rgba(0,0,0,.25)}
@media(max-width:768px){.product-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:480px){.product-grid{grid-template-columns:1fr}}

/* Modal */
.modal{display:none;position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,.65)}
.overlay{position:absolute;inset:0}
.box{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:400px;max-height:504px;background:#fff;border-radius:8px;overflow:hidden}
.close{position:absolute;top:16px;right:16px;font-size:24px;color:#666;background:none;border:none;cursor:pointer}
#img{width:100%;height:150px;object-fit:cover}
.body{padding:24px 32px}
#title{font:600 20px/1.3 Inter;margin:0 0 4px}
#price{font:400 18px/1.4 Inter;margin:0 0 12px}
.btn{width:100%;height:48px;background:#000;color:#fff;border:none;border-radius:4px;font:600 16px/1 Inter;text-transform:uppercase;cursor:pointer}
.btn:hover{background:#333}
</style>

<script>
(()=>{
  const modal=document.getElementById('modal');
  const form=document.getElementById('form');
  const vid=document.getElementById('vid');
  const render=p=>{
    document.getElementById('img').src=p.images[0];
    document.getElementById('title').textContent=p.title;
    document.getElementById('price').textContent=Shopify.formatMoney(p.price_min);
    vid.value=p.variants[0].id;
  };
  document.addEventListener('click',e=>{
    if(!e.target.classList.contains('quick-btn'))return;
    fetch(`/products/${e.target.dataset.id}.js`)
      .then(r=>r.json())
      .then(p=>{render(p);modal.style.display='block';document.body.style.overflow='hidden';});
  });
  form.addEventListener('submit',e=>{
    e.preventDefault();
    fetch('/cart/add.js',{method:'POST',body:new FormData(form)})
      .then(()=>{modal.style.display='none';document.body.style.overflow='';});
  });
  ['keydown','click','click'].forEach(ev=>{
    if(ev==='keydown'){
      document.addEventListener(ev,e=>{if(e.key==='Escape')modal.style.display='none'});
    }else{
      document.querySelector('.close, .overlay').addEventListener(ev,()=>{modal.style.display='none';document.body.style.overflow='';});
    }
  });
})();
</script>

{% schema %}
{"name":"Gift Guide","settings":[
{"type":"text","id":"title","label":"Title","default":"The Gift Guide"},
{"type":"textarea","id":"description","label":"Description","default":"Discover Joy"},
{"type":"text","id":"cta_text","label":"CTA","default":"SHOP NOW"},
{"type":"url","id":"cta_url","label":"URL"},
{"type":"product","id":"product_1","label":"Product 1"},
{"type":"product","id":"product_2","label":"Product 2"},
{"type":"product","id":"product_3","label":"Product 3"},
{"type":"product","id":"product_4","label":"Product 4"},
{"type":"product","id":"product_5","label":"Product 5"},
{"type":"product","id":"product_6","label":"Product 6"}
],"presets":[{"name":"Gift Guide"}]}
{% endschema %}