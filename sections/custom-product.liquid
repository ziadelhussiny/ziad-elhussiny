{%- liquid
  assign p1 = section.settings.product_1
  assign p2 = section.settings.product_2
  assign p3 = section.settings.product_3
  assign p4 = section.settings.product_4
  assign p5 = section.settings.product_5
  assign p6 = section.settings.product_6
  assign handles = p1 | append: '|' | append: p2 | append: '|' | append: p3 | append: '|' | append: p4 | append: '|' | append: p5 | append: '|' | append: p6 | split: '|' | compact | slice: 0, 6

  assign title    = section.settings.title | default: "The Gift Guide"
  assign desc     = section.settings.description | default: "Discover Joy: Your Ultimate Holiday Gift Destination."
  assign cta_text = section.settings.cta_text | default: "SHOP NOW"
  assign cta_url  = section.settings.cta_url | default: '#'
-%}

<section class="gift-guide-section">
  <div class="gift-guide-header">
    <h2>{{ title }}</h2>
    <p>{{ desc }}</p>
    <a href="{{ cta_url }}" class="cta-button">{{ cta_text }}</a>
  </div>

  <div class="product-grid">
    {%- for handle in handles -%}
      {%- assign product = all_products[handle] -%}
      {%- if product -%}
        <div class="product-card">
          <div class="img-wrap">
            <img src="{{ product.featured_image | img_url: '600x600' }}"
                 alt="{{ product.title }}" loading="lazy">
            <button class="quick-btn" data-id="{{ product.id }}">+</button>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<!-- Quick-view modal (injected once) -->
<div id="quick-modal" class="modal">
  <div class="modal-content">
    <span class="close">&times;</span>
    <div id="modal-inner"></div>
  </div>
</div>

<style>
.gift-guide-section{max-width:1200px;margin:0 auto;padding:40px 20px;font-family:Helvetica,Arial,sans-serif;}
.gift-guide-header{text-align:center;margin-bottom:30px;}
.gift-guide-header h2{font-size:2.5rem;margin-bottom:15px;color:#333;}
.gift-guide-header p{font-size:1.1rem;color:#666;margin-bottom:25px;}
.cta-button{display:inline-block;padding:14px 32px;background:#000;color:#fff;text-decoration:none;border-radius:4px;font-weight:600;text-transform:uppercase;transition:background 0.3s ease;}
.cta-button:hover{background:#333;}
.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px;}
.product-card{position:relative;overflow:hidden;}
.img-wrap{position:relative;overflow:hidden;border-radius:8px;}
.img-wrap img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;}
.quick-btn{position:absolute;top:15px;right:15px;width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,0.9);color:#333;border:none;font-size:18px;cursor:pointer;line-height:1;font-weight:bold;box-shadow:0 2px 8px rgba(0,0,0,0.2);transition:all 0.3s ease;}
.quick-btn:hover{background:#fff;transform:scale(1.1);}
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:9999;}
.modal-content{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#fff;padding:30px;border-radius:12px;max-width:400px;width:90%;box-shadow:0 20px 40px rgba(0,0,0,0.2);}
.close{position:absolute;top:15px;right:20px;font-size:28px;cursor:pointer;color:#999;transition:color 0.3s ease;}
.close:hover{color:#333;}
.modal h3{margin-bottom:15px;color:#333;}
.modal img{border-radius:8px;}
.modal select{width:100%;padding:10px;border:1px solid #ddd;border-radius:4px;margin:10px 0;}
.modal .cta-button{margin-top:15px;}

/* Responsive Design */
@media (max-width: 768px) {
  .product-grid{grid-template-columns:repeat(2,1fr);gap:15px;}
  .gift-guide-header h2{font-size:2rem;}
  .modal-content{padding:20px;margin:20px;}
}
@media (max-width: 480px) {
  .product-grid{grid-template-columns:1fr;gap:15px;}
  .quick-btn{width:28px;height:28px;font-size:16px;top:10px;right:10px;}
}
</style>

<script>
(() => {
  const modal   = document.getElementById('quick-modal');
  const inner   = document.getElementById('modal-inner');
  const close   = modal.querySelector('.close');

  /* open modal */
  document.addEventListener('click', e => {
    if (!e.target.classList.contains('quick-btn')) return;
    e.preventDefault();

    const id = e.target.dataset.id;
    fetch(`/products/${id}.js`)
      .then(r => r.json())
      .then(p => renderModal(p))
      .catch(err => {
        console.error('Error loading product:', err);
        alert('Sorry, there was an error loading the product details.');
      });
  });

  /* close modal */
  close.onclick = () => modal.style.display = 'none';
  modal.onclick  = e => { if (e.target === modal) modal.style.display = 'none'; };

  /* close modal with escape key */
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && modal.style.display === 'block') {
      modal.style.display = 'none';
    }
  });

  /* render HTML inside modal */
  function renderModal(p) {
    if (!p || !p.variants || p.variants.length === 0) {
      inner.innerHTML = '<p>Product details unavailable.</p>';
      modal.style.display = 'block';
      return;
    }

    const variants = p.variants.map(v => 
      `<option value="${v.id}" ${!v.available ? 'disabled' : ''}>${v.title}${!v.available ? ' - Sold Out' : ''}</option>`
    ).join('');
    
    const price = p.price_min ? (p.price_min / 100).toFixed(2) : '0.00';
    const imageUrl = p.images && p.images[0] ? p.images[0] : p.featured_image;
    
    inner.innerHTML = `
      <h3>${p.title}</h3>
      ${imageUrl ? `<img src="${imageUrl}" alt="${p.title}" style="width:100%;max-width:200px;margin-bottom:15px;border-radius:8px;">` : ''}
      <p style="font-size:1.2rem;font-weight:700;margin:15px 0;">$${price}</p>
      ${p.description ? `<p style="font-size:0.9rem;color:#666;margin-bottom:20px;">${p.description.substring(0, 150)}${p.description.length > 150 ? '...' : ''}</p>` : ''}
      <form action="/cart/add" method="post" onsubmit="return handleAddToCart(event)">
        <label style="display:block;margin-bottom:15px;text-align:left;">
          <strong>Variant:</strong><br>
          <select name="id" required style="width:100%;padding:10px;border:1px solid #ddd;border-radius:4px;margin-top:5px;">${variants}</select>
        </label>
        <button type="submit" class="cta-button" style="width:100%;">ADD TO CART</button>
      </form>
    `;
    modal.style.display = 'block';
  }

  /* handle add to cart form submission */
  window.handleAddToCart = function(event) {
    event.preventDefault();
    const form = event.target;
    const formData = new FormData(form);
    
    fetch('/cart/add.js', {
      method: 'POST',
      body: formData
    })
    .then(response => response.json())
    .then(data => {
      modal.style.display = 'none';
      // Show success message or redirect
      alert('Product added to cart!');
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Sorry, there was an error adding the product to cart.');
    });
    
    return false;
  };
})();
</script>

{% schema %}
{
  "name": "Gift Guide",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    },
    {
      "type": "product",
      "id": "product_5",
      "label": "Product 5"
    },
    {
      "type": "product",
      "id": "product_6",
      "label": "Product 6"
    }
  ],
  "presets": [
    { "name": "Gift Guide" }
  ]
}
{% endschema %}